---
/**
 * Plays the application's part in the markdown gallery: the French of the En français card, under `lang="fr"`.
 */
---

<script>
  import { addTranslations } from '@c2n/core/localize.js'

  addTranslations({
    fr: {
      markdown: {
        table: 'Tableau',
      },
    },
  })
</script>
