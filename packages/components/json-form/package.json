{
  "name": "@c2n/json-form",
  "version": "0.0.13",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./types/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./json-form.js": {
      "types": "./types/src/json-form.d.ts",
      "default": "./dist/json-form.js"
    },
    "./json-field.js": {
      "types": "./types/src/json-field.d.ts",
      "default": "./dist/json-field.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "dist",
    "types",
    "custom-elements.json",
    "react.d.ts",
    "react.js",
    "vue.d.ts",
    "vue.js"
  ],
  "keywords": [
    "json form",
    "json schema",
    "json schema form",
    "dynamic form",
    "web component",
    "lit"
  ],
  "author": "code2nguyen@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/code2nguyen/web-components.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "wireit",
    "build:only": "vite build",
    "type-check": "wireit"
  },
  "wireit": {
    "type-check": {
      "dependencies": [
        "../../core:build",
        "../button:build",
        "../card:build",
        "../checkbox:build",
        "../date-input:build",
        "../date-time-picker:build",
        "../details:build",
        "../form-field:build",
        "../list-item:build",
        "../number-input:build",
        "../password-field:build",
        "../radio:build",
        "../select:build",
        "../slider:build",
        "../steps:build",
        "../switch:build",
        "../tabs:build",
        "../tag-input:build",
        "../text-field:build",
        "../textarea:build",
        "../time-input:build"
      ],
      "command": "tsc -p tsconfig.lib.json --composite false"
    },
    "build": {
      "dependencies": [
        "type-check"
      ],
      "command": "vite build"
    }
  },
  "dependencies": {
    "@c2n/core": "workspace:*",
    "@c2n/button": "workspace:*",
    "@c2n/card": "workspace:*",
    "@c2n/checkbox": "workspace:*",
    "@c2n/date-input": "workspace:*",
    "@c2n/date-time-picker": "workspace:*",
    "@c2n/details": "workspace:*",
    "@c2n/form-field": "workspace:*",
    "@c2n/list-item": "workspace:*",
    "@c2n/number-input": "workspace:*",
    "@c2n/password-field": "workspace:*",
    "@c2n/radio": "workspace:*",
    "@c2n/select": "workspace:*",
    "@c2n/slider": "workspace:*",
    "@c2n/steps": "workspace:*",
    "@c2n/switch": "workspace:*",
    "@c2n/tabs": "workspace:*",
    "@c2n/tag-input": "workspace:*",
    "@c2n/text-field": "workspace:*",
    "@c2n/textarea": "workspace:*",
    "@c2n/time-input": "workspace:*",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@c2n/config": "workspace:*",
    "@c2n/sass": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-cem": "catalog:"
  },
  "customElements": "custom-elements.json"
}
