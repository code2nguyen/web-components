---
import logoRef from '../assets/logo.svg?raw'
// Base theme first: maps every c2 component variable onto the --c2-theme--* tokens that assets/c2-theme.scss bridges.
import '@c2n/theme/base.css'
import '../assets/global.scss'
import SiteIconButton from '../components/ui/SiteIconButton.astro'
import { FeatherGithubIcon, FeatherMenuIcon, FeatherSearchIcon } from '../components/ui/icons'
import { Header } from '@c2n/header'
import { LinkButton } from '@c2n/link-button'
import ThemeToggle from '../components/ThemeToggle.astro'
import SearchPalette from '../components/SearchPalette.astro'
import { packageVersion } from '../data/package-release'

const base = import.meta.env.BASE_URL

interface Props {
  title: string
  description?: string
  /** Render the mobile "open navigation" button (docs pages). */
  withSidebar?: boolean
  /** Which top-level nav item is active. */
  section?: 'components' | 'icons' | 'guides' | 'examples'
}
const { title, description = 'A library of small, themable Lit web components published as individual npm packages.', withSidebar, section } = Astro.props
const repoUrl = 'https://github.com/code2nguyen/web-components'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate" type="text/plain" href={`${base}/llms.txt`} title="llms.txt" />
    <title>{title}</title>
    <script is:inline>
      // Resolve the theme before first paint to avoid a flash.
      ;(function () {
        try {
          var stored = localStorage.getItem('c2n-theme')
          var theme = stored === 'light' || stored === 'dark' ? stored : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
          document.documentElement.dataset.theme = theme
        } catch (e) {
          document.documentElement.dataset.theme = 'light'
        }
      })()
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header client:load class="site-header" sticky blurred navigation-label="Primary">
      <div slot="brand" class="site-header__brand-group">
        <a href={`${base}/`} class="site-header__brand" aria-label="c2n web components home">
          <Fragment set:html={logoRef} />
          <span class="site-header__wordmark">c2n<span class="site-header__wordmark-muted">/web-components</span></span>
        </a>
        <a
          class="site-header__version"
          href="https://www.npmjs.com/org/c2n"
          target="_blank"
          rel="noreferrer"
          aria-label={`Version ${packageVersion} packages on npm`}
        >
          v{packageVersion}
        </a>
      </div>

      <div class="site-header__nav">
        <LinkButton client:load class="site-header__nav-link" href={`${base}/components/`} selected={section === 'components'}>Components</LinkButton>
        <LinkButton client:load class="site-header__nav-link" href={`${base}/icons/`} selected={section === 'icons'}>Icons</LinkButton>
        <LinkButton client:load class="site-header__nav-link" href={`${base}/guides/`} selected={section === 'guides'}>Guides</LinkButton>
        <LinkButton client:load class="site-header__nav-link" href={`${base}/examples/`} selected={section === 'examples'}>Examples</LinkButton>
        <LinkButton client:load class="site-header__nav-link" href={`${base}/#getting-started`}>Getting started</LinkButton>
      </div>

      <div slot="actions" class="site-header__actions">
        <SiteIconButton label="Search components" tooltip="Search components (⌘K)" class="site-header__search" data-open-search>
          <FeatherSearchIcon client:load />
        </SiteIconButton>
        <ThemeToggle />
        <LinkButton client:load class="site-header__github" href={repoUrl} external aria-label="GitHub repository">
          <FeatherGithubIcon client:load slot="prefix-icon" />
          <c2-tooltip>GitHub repository</c2-tooltip>
        </LinkButton>
      </div>

      {
        withSidebar && (
          <div slot="mobile-trigger" class="site-header__mobile-trigger">
            <SiteIconButton label="Open navigation" tooltip={false} class="site-header__menu" data-toggle-sidebar>
              <FeatherMenuIcon client:load />
            </SiteIconButton>
          </div>
        )
      }
    </Header>

    <main id="main" class="site-main">
      <slot />
    </main>

    <slot name="footer">
      <footer class="site-footer">
        <div class="site-footer__inner">
          <span>© {new Date().getFullYear()} code2nguyen · MIT licensed</span>
          <span class="site-footer__links">
            <a href={repoUrl} target="_blank" rel="noreferrer">GitHub</a>
            <a href="https://www.npmjs.com/org/c2n" target="_blank" rel="noreferrer">npm</a>
            <a href={`${base}/llms.txt`}>llms.txt</a>
          </span>
        </div>
      </footer>
    </slot>

    <SearchPalette />

    <style lang="scss">
      .skip-link {
        position: absolute;
        left: 16px;
        top: -100px;
        z-index: 2000;
        padding: 8px 12px;
        background: var(--site-color-primary);
        color: var(--site-color-on-primary);
        border-radius: var(--site-radius-sm);
        &:focus {
          top: 8px;
        }
      }

      // Theme the Lit island host globally, matching the site's other component wrappers.
      :global(.site-header) {
        z-index: 1000;
        --c2-header--min-height: var(--site-header-height);
        --c2-header--padding: 0 var(--site-gutter);
        --c2-header--gap: 8px;
        --c2-header--background: var(--site-color-surface);
        --c2-header--border-bottom: 1px solid var(--site-color-outline-variant);
        --c2-header--backdrop-filter: saturate(180%) blur(12px);
        --c2-header__blurred--background: color-mix(in srgb, var(--site-color-surface) 85%, transparent);
        --c2-header__content--max-width: var(--site-page-max-width);
        --c2-header__brand--gap: 0;
        --c2-header__actions--gap: 0;
      }

      .site-header {
        &__brand-group,
        &__actions,
        &__mobile-trigger {
          display: flex;
          align-items: center;
          gap: 8px;
        }
        &__actions {
          gap: 4px;
        }
        &__mobile-trigger {
          display: none;
        }

        // Hosts rendered by SiteIconButton / LinkButton carry no scoped attribute, hence :global().
        :global(.site-header__menu) {
          display: inline-flex;
        }
        :global(.site-header__github) {
          --c2-link-button__container--padding-top: 9px;
          --c2-link-button__container--padding-right: 9px;
          --c2-link-button__container--padding-bottom: 9px;
          --c2-link-button__container--padding-left: 9px;
          --c2-link-button__container--gap: 0;
          --c2-link-button__container--border-radius: var(--site-radius-sm);
          --c2-link-button__container--color: var(--site-color-on-surface-variant);
          --c2-link-button__container__hover--color: var(--site-color-on-surface);
          --c2-link-button__container__hover--background-color: var(--site-color-surface-container-3);
          --c2-link-button__container__hover--text-decoration: none;
          --c2-link-button__icon--size: 16px;
        }

        &__brand {
          display: inline-flex;
          align-items: center;
          gap: 10px;
          color: var(--site-color-on-surface);
          text-decoration: none;
          font-weight: 600;
          font-size: 15px;
          letter-spacing: -0.01em;
          margin-right: 0;
          :global(svg) {
            width: 22px;
            height: 22px;
            flex: none;
          }
          &:hover {
            text-decoration: none;
          }
        }
        &__version {
          margin-right: 16px;
          padding: 2px 7px;
          border: 1px solid var(--site-color-outline-variant);
          border-radius: 999px;
          color: var(--site-color-on-surface-muted);
          background: var(--site-color-surface-container-1);
          font-size: 11px;
          line-height: 1.4;
          text-decoration: none;
          white-space: nowrap;
          &:hover {
            color: var(--site-color-primary);
            border-color: var(--site-color-outline);
            text-decoration: none;
          }
        }
        &__wordmark-muted {
          color: var(--site-color-on-surface-muted);
          font-weight: 400;
        }

        &__nav {
          display: flex;
          align-items: center;
          gap: 12px;
        }

        :global(.site-header__nav-link) {
          --c2-link-button__container--padding-top: 6px;
          --c2-link-button__container--padding-right: 10px;
          --c2-link-button__container--padding-bottom: 6px;
          --c2-link-button__container--padding-left: 10px;
          --c2-link-button__container--border-radius: var(--site-radius-sm);
          --c2-link-button__container--background-color: transparent;
          --c2-link-button__container--color: var(--site-color-on-surface-variant);
          --c2-link-button__container--font-size: 14px;
          --c2-link-button__container--font-weight: 500;
          --c2-link-button__container--text-decoration: none;
          --c2-link-button__container__hover--color: var(--site-color-on-surface);
          --c2-link-button__container__hover--background-color: var(--site-color-surface-container-2);
          --c2-link-button__container__hover--text-decoration: none;
          --c2-link-button__container__selected--color: var(--site-color-on-surface);
          --c2-link-button__container__selected--background-color: transparent;
          --c2-link-button__container__selected--font-weight: 500;
          --c2-link-button__container__selected--text-decoration: none;
          --c2-link-button__container__focus--outline: 2px solid var(--site-color-primary);
          &:hover {
            --c2-link-button__container__selected--background-color: var(--site-color-surface-container-2);
          }
        }

        :global(.site-header__search) {
          --c2-icon-button__icon--width: 16px;
          --c2-icon-button__icon--height: 16px;
        }
      }

      .site-main {
        min-height: calc(100vh - var(--site-header-height));
      }

      .site-footer {
        border-top: 1px solid var(--site-color-outline-variant);
        font-size: 13px;
        color: var(--site-color-on-surface-muted);
        &__inner {
          max-width: var(--site-page-max-width);
          margin: 0 auto;
          padding: 24px var(--site-gutter);
          display: flex;
          justify-content: space-between;
          gap: 16px;
          flex-wrap: wrap;
        }
        &__links {
          display: flex;
          gap: 16px;
          a {
            color: var(--site-color-on-surface-variant);
          }
        }
      }

      @media (max-width: 959.98px) {
        :global(.site-header::part(mobile-trigger)) {
          order: -1;
        }
        .site-header {
          &__nav {
            display: none;
          }
          &__mobile-trigger {
            display: flex;
          }
        }
      }
      @media (max-width: 599.98px) {
        .site-header__wordmark-muted {
          display: none;
        }
      }
    </style>
  </body>
</html>
