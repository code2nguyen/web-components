{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slot-styling-audit.schema.json",
  "title": "c2n slot styling audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "slot", "decision", "reason"],
      "properties": {
        "tag": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-[a-z0-9-]+$" },
        "slot": { "type": "string" },
        "decision": { "enum": ["part", "variables", "assigned-content", "delegated"] },
        "parts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "variables": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^--" } },
        "delegateTag": { "type": "string" },
        "reason": { "type": "string", "minLength": 1 },
        "states": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
