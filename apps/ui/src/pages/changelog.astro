---
import Main from '../layouts/Main.astro'
import changelog from '../data/changelog.json'
import { escapeHtml, rawElement } from '../utils/raw-element'

// Generated by `npm run changelog` (scripts/generate-changelog.mjs); CHANGELOG.md has the full list. This page keeps
// it short: package changes only (no docs-site entries), releases with nothing to show are skipped, and each section
// shows its first few lines with the rest behind one disclosure.
type Item = { scopes: string[]; text: string; hash: string }
type Section = { type: string; title: string; items: Item[] }
type Release = { version: string; date: string; sections: Section[] }

const LABELS: Record<string, string> = { breaking: 'Breaking', feat: 'New', fix: 'Fixed', perf: 'Faster', improve: 'Improved' }
const VISIBLE_PER_SECTION = 3

const { repository } = changelog
const releases = (changelog.releases as Release[])
  .map((release) => {
    const sections = release.sections.filter((section) => section.type in LABELS)
    return {
      ...release,
      shown: sections.map((section) => ({ ...section, items: section.items.slice(0, VISIBLE_PER_SECTION) })),
      hidden: sections.map((section) => ({ ...section, items: section.items.slice(VISIBLE_PER_SECTION) })).filter((section) => section.items.length > 0),
      counts: sections.map((section) => `${section.items.length} ${LABELS[section.type].toLowerCase()}`).join(' · '),
    }
  })
  .filter((release) => release.shown.length > 0)

const formatDate = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
const hiddenCount = (sections: Section[]) => sections.reduce((total, section) => total + section.items.length, 0)

// Raw markup rather than JSX: `@astrojs/lit` would server-render every registered c2 tag with `defer-hydration`, which
// nothing removes outside an island (see utils/raw-element.ts). The page script below upgrades the plain tags.
const renderSections = (sections: Section[]) =>
  sections
    .map((section) => {
      const items = section.items
        .map(
          (item) =>
            `<li>${item.scopes.map((scope) => rawElement('c2-badge', { class: 'scope' }, escapeHtml(scope))).join('')}<span>${escapeHtml(item.text)}</span></li>`,
        )
        .join('')
      return `<section class="group group--${section.type}"><h2 class="group__title">${LABELS[section.type]}</h2><ul class="group__items">${items}</ul></section>`
    })
    .join('')

const timeline = rawElement(
  'c2-timeline',
  { class: 'changelog__timeline', 'aria-label': 'Releases' },
  releases
    .map((release, index) => {
      const link = `<a href="${repository}/releases/tag/v${release.version}" target="_blank" rel="noreferrer">v${release.version}</a>`
      const latest = index === 0 ? rawElement('c2-badge', { tone: 'primary' }, 'Latest') : ''
      const more =
        release.hidden.length > 0
          ? rawElement('c2-details', { class: 'release__more', label: `${hiddenCount(release.hidden)} more` }, renderSections(release.hidden))
          : ''
      return rawElement(
        'c2-timeline-item',
        { tone: index === 0 ? 'primary' : undefined, datetime: release.date },
        `<span slot="label" class="release__label">${link}${latest}</span>` +
          `<span slot="timestamp" class="release__meta">${formatDate(release.date)} · ${release.counts}</span>` +
          `<div class="release">${renderSections(release.shown)}${more}</div>`,
      )
    })
    .join(''),
)
---

<Main title="Changelog · c2n web components" description="What changed in each release of the @c2n web component packages.">
  <div class="changelog">
    <header class="changelog__header">
      <h1>Changelog</h1>
      <p>
        Every <code>@c2n/*</code> package ships under one version. The highlights are below; the
        <a href={`${repository}/blob/develop/CHANGELOG.md`} target="_blank" rel="noreferrer">full changelog</a> lists every change.
      </p>
    </header>

    <Fragment set:html={timeline} />
  </div>
</Main>

<script>
  // Plain tags upgraded here rather than one island per release: the page repeats each element dozens of times.
  import '@c2n/timeline'
  import '@c2n/badge'
  import '@c2n/details'
</script>

<style lang="scss">
  .changelog {
    max-width: 760px;
    margin: 0 auto;
    padding: 56px var(--site-gutter) 96px;

    &__header {
      margin-bottom: 40px;
      h1 {
        margin: 0 0 8px;
        font-size: clamp(2rem, 4vw, 2.6rem);
        letter-spacing: -0.02em;
        font-weight: 700;
      }
      p {
        margin: 0;
        color: var(--site-color-on-surface-variant);
      }
      code {
        font-size: 0.85em;
        padding: 2px 6px;
        border-radius: 5px;
        background: var(--site-color-surface-container-3);
        color: var(--site-color-on-surface);
      }
      a {
        color: var(--site-color-primary);
      }
    }
  }
</style>

<!-- The timeline is raw markup (set:html), which scoped styles do not reach: its rules are global, under .changelog. -->
<style lang="scss" is:global>
  .changelog {
    .changelog__timeline {
      display: block;
      --c2-timeline-item--gap: 16px;
      --c2-timeline-item--padding-bottom: 36px;
      --c2-timeline-item__connector--background: var(--site-color-outline-variant);
      --c2-timeline-item__marker--background: var(--site-color-surface);
      --c2-timeline-item__label--font-size: 18px;
      --c2-timeline-item__label--line-height: 26px;
      --c2-timeline-item__label--font-weight: 650;
      --c2-timeline-item__label--color: var(--site-color-on-surface);
      --c2-timeline-item__timestamp--color: var(--site-color-on-surface-muted);
      --c2-timeline-item__content--margin-top: 12px;
      --c2-timeline-item__content--color: var(--site-color-on-surface);
    }

    .release {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .release__label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      a {
        color: inherit;
        text-decoration: none;
        &:hover {
          color: var(--site-color-primary);
        }
      }
    }

    .release__meta {
      font-variant-numeric: tabular-nums;
    }

    .release__more {
      display: block;
      --c2-details--border-top: none;
      --c2-details--border-bottom: none;
      --c2-details--border-left: none;
      --c2-details--border-right: none;
      --c2-details--background: transparent;
      --c2-details__header--padding-top: 2px;
      --c2-details__header--padding-bottom: 2px;
      --c2-details__header--padding-left: 0;
      --c2-details__header--padding-right: 0;
      --c2-details__header--font-size: 13px;
      --c2-details__header--font-weight: 500;
      --c2-details__header--color: var(--site-color-on-surface-variant);
      --c2-details__header__hover--background: transparent;
      --c2-details__header__hover--color: var(--site-color-primary);
      --c2-details__header__open--background: transparent;
      --c2-details__content--padding-top: 12px;
      --c2-details__content--padding-left: 0;
      --c2-details__content--padding-right: 0;
      --c2-details__content--padding-bottom: 0;
      --c2-details__content--border-top: none;
      --c2-details__content--color: var(--site-color-on-surface);
      .group + .group {
        margin-top: 14px;
      }
    }

    .group {
      --changelog-dot: var(--site-color-on-surface-muted);
    }
    .group--breaking {
      --changelog-dot: var(--site-color-error);
    }
    .group--feat {
      --changelog-dot: var(--site-color-primary);
    }
    .group--fix {
      --changelog-dot: #16a34a;
    }
    .group--perf {
      --changelog-dot: var(--site-color-warning);
    }

    .group__title {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 0 0 6px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--site-color-on-surface-variant);
      &::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--changelog-dot);
      }
    }

    .group__items {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 14px;
      line-height: 1.5;
      li {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 6px;
      }
    }

    .scope {
      --c2-badge--font-size: 11px;
      --c2-badge--font-family: var(--site-font-mono);
      --c2-badge__neutral--background: var(--site-color-surface-container-3);
      --c2-badge__neutral--color: var(--site-color-on-surface-variant);
    }
  }
</style>
