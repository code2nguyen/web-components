---
/**
 * Plays the application's part in the pagination gallery: the French of the En français card, under `lang="fr"`.
 */
---

<script>
  import { addTranslations } from '@c2n/core/localize.js'

  addTranslations({
    fr: {
      pagination: {
        label: 'Pagination',
        previous: 'Précédent',
        next: 'Suivant',
        first: 'Première',
        last: 'Dernière',
        pageSize: 'Lignes par page :',
        range: '{0}–{1} sur {2}',
        page: 'Page {0} sur {1}',
        goToPage: 'Aller à la page {0}',
        jump: 'Aller à la page {0}, {1} pages sautées',
      },
    },
  })
</script>
