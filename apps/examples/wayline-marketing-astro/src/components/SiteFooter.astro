---
import Logo from './Logo.astro'
import { product } from '../data/site'

// Only the sections of this page are real destinations; the rest name pages a made-up company would have, so they
// are listed as text rather than as links that go nowhere.
const columns = [
  {
    title: 'Product',
    items: [
      { label: 'Integrations', href: '#integrations' },
      { label: 'Features', href: '#features' },
      { label: 'Pricing', href: '#pricing' },
      { label: 'FAQ', href: '#faq' },
    ],
  },
  { title: 'Company', items: [{ label: 'About' }, { label: 'Customers' }, { label: 'Careers' }, { label: 'Contact' }] },
  { title: 'Resources', items: [{ label: 'Docs' }, { label: 'Guides' }, { label: 'Status' }, { label: 'Security' }] },
]
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <span class="brand"><Logo /> {product.name}</span>
      <p>{product.tagline}</p>
    </div>
    {
      columns.map((column) => (
        <div class="site-footer__column">
          <h2>{column.title}</h2>
          <ul>
            {column.items.map((item) => (
              <li>{item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <p class="container site-footer__note">
    {product.name} is a made-up product. This page is an example app for the c2n web components, built with Astro.
  </p>
</footer>
