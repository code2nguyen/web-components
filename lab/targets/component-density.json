{
  "name": "component-density",
  "spec": "lab/specs/scenarios/component-density.md",
  "title": "component-density (default direction): the cost of 1,000 instances of each component, from a production build.",
  "app": "lab/apps/component-density/default",
  "url": "http://127.0.0.1:4197/",
  "server": {
    "command": "npx vite build lab/apps/component-density/default --outDir ../../../../test-results/lab-builds/component-density-default --emptyOutDir && npx vite preview lab/apps/component-density/default --outDir ../../../../test-results/lab-builds/component-density-default --host 127.0.0.1 --port 4197 --strictPort",
    "cwd": ".",
    "timeout": 180000
  },
  "journeys": [
    {
      "id": "d-plain",
      "title": "T1 \u00b7 1,000 \u00d7 plain",
      "personas": ["mouse"],
      "cpu": 4,
      "steps": [
        {
          "goto": "./?tag=plain&n=1000"
        },
        {
          "expect": {
            "text": {
              "css": "#status"
            },
            "contains": "Ready: plain"
          }
        },
        {
          "memory": "baseline"
        },
        {
          "mark": "mount",
          "watch": {
            "css": "#status",
            "text": "Mounted"
          }
        },
        {
          "press": "m"
        },
        {
          "expect": {
            "text": {
              "css": "#status"
            },
            "contains": "Mounted 1000"
          },
          "timeout": 15000
        },
        {
          "budget": {
            "since": "mount",
            "label": "plain",
            "until": 100,
            "heapGrowthMB": 5,
            "nodesGrowth": 10000000
          }
        }
      ]
    },
