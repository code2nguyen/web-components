---
import Main from '../layouts/Main.astro'
import CodeBlock from '../components/CodeBlock.astro'

const base = import.meta.env.BASE_URL

const installCode = `npm install @c2n/text-field`
const importCode = `import '@c2n/text-field'

// then anywhere in your markup
<c2-text-field placeholder="Your email"></c2-text-field>`
const themeCode = `.newsletter c2-text-field {
  --c2-text-field--border-radius: 12px;
  --c2-text-field--background: #f4f4f5;
  --c2-text-field__focus--border: 1px solid #2563eb;
}`
const slotCode = `<c2-text-field placeholder="Search">
  <svg slot="prefix-icon" viewBox="0 0 24 24">…</svg>
</c2-text-field>`
---

<Main
  title="Getting started · c2n web components"
  description="Install a c2n package, register its element and theme it with CSS custom properties."
  section="getting-started"
>
  <div class="getting-started">
    <section class="section" aria-labelledby="getting-started-title">
      <div class="section__header">
        <h1 id="getting-started-title">Getting started</h1>
        <p>Four steps from an empty project to a themed component.</p>
      </div>
      <ol class="steps">
        <li class="step">
          <div class="step__text">
            <span class="step__number">1</span>
            <h3>Install the packages you need</h3>
            <p>
              Each component ships as its own package under the <code>@c2n</code> scope, so you only pay for what you use. Lit is a peer dependency shared between
              them.
            </p>
          </div>
          <CodeBlock code={installCode} lang="bash" />
        </li>
        <li class="step">
          <div class="step__text">
            <span class="step__number">2</span>
            <h3>Import once, use anywhere</h3>
            <p>Importing a package registers its <code>c2-*</code> custom element. After that it is plain HTML.</p>
          </div>
          <CodeBlock code={importCode} lang="html" />
        </li>
        <li class="step">
          <div class="step__text">
            <span class="step__number">3</span>
            <h3>Theme with CSS custom properties</h3>
            <p>
              Every visual detail is exposed as a variable named <code>--c2-&lt;component&gt;__&lt;part&gt;--&lt;property&gt;</code>. Set them on any ancestor
              to restyle a component, a section, or the whole app. Or load <a href={`${base}/guides/theming`}>@c2n/theme</a> and set a handful of design tokens once.
            </p>
          </div>
          <CodeBlock code={themeCode} lang="css" />
        </li>
        <li class="step">
          <div class="step__text">
            <span class="step__number">4</span>
            <h3>Extend with slots</h3>
            <p>Named slots let you replace icons and inject content without forking the component.</p>
          </div>
          <CodeBlock code={slotCode} lang="html" />
        </li>
      </ol>
    </section>
  </div>
</Main>

<style lang="scss">
  .getting-started {
    max-width: var(--site-page-max-width);
    margin: 0 auto;
    padding: 0 var(--site-gutter) 96px;
  }

  .section {
    padding: 56px 0 0;
    scroll-margin-top: var(--site-header-height);
    &__header {
      margin-bottom: 32px;
      max-width: 620px;
      h1 {
        margin: 0 0 8px;
        font-size: clamp(2rem, 4vw, 2.6rem);
        letter-spacing: -0.02em;
        font-weight: 700;
      }
      p {
        margin: 0;
        color: var(--site-color-on-surface-variant);
      }
    }
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .step {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 32px;
    align-items: start;
    &__text {
      position: relative;
      padding-left: 44px;
      h3 {
        margin: 0 0 8px;
        font-size: 1.1rem;
        font-weight: 600;
      }
      p {
        margin: 0;
        color: var(--site-color-on-surface-variant);
      }
      code {
        font-size: 0.85em;
        padding: 2px 6px;
        border-radius: 5px;
        background: var(--site-color-surface-container-3);
        color: var(--site-color-on-surface);
      }
    }
    &__number {
      position: absolute;
      left: 0;
      top: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: var(--site-color-primary-soft);
      color: var(--site-color-primary);
      font-size: 13px;
      font-weight: 600;
    }
  }

  @media (max-width: 959.98px) {
    .step {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
  }
</style>
