{
  "name": "@c2n/example-orders-admin-angular",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ng serve",
    "build": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "../../../packages/adapters/angular:build",
        "../../../packages/umbrella:build",
        "../../../packages/core:build",
        "../../../packages/tools/theme:build"
      ],
      "files": [
        "src/**",
        "angular.json",
        "tsconfig*.json"
      ],
      "output": [
        "dist/**"
      ],
      "command": "ng build"
    }
  },
  "dependencies": {
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@c2n/angular": "*",
    "@c2n/components": "*",
    "@c2n/theme": "*",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@c2n/config": "*"
  }
}
