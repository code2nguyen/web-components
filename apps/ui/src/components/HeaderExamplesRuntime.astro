---
/**
 * Plays the application's part in the header gallery: the French of the En français card, under `lang="fr"`.
 */
---

<script>
  import { addTranslations } from '@c2n/core/localize.js'

  addTranslations({
    fr: {
      header: {
        navigation: 'Principale',
      },
    },
  })
</script>
