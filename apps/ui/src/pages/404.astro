---
// Built as dist/404.html, which GitHub Pages serves for any missing path under the project site.
import Main from '../layouts/Main.astro'
import SiteButton from '../components/ui/SiteButton.astro'
import { StatusPanel } from '@c2n/components/status-panel'
import { NotFoundSymbol } from '@c2n/symbols/symbols/not-found.js'
import { FeatherSearchIcon } from '../components/ui/icons'

const base = import.meta.env.BASE_URL

const destinations = [
  { href: `${base}/getting-started/`, title: 'Getting started', description: 'Install a package and theme your first component.' },
  { href: `${base}/components/`, title: 'Components', description: 'Browse every c2-* element with live examples.' },
  { href: `${base}/icons/`, title: 'Icons', description: 'Feather, Phosphor and the hand-drawn symbol set.' },
  { href: `${base}/guides/`, title: 'Guides', description: 'Theming, frameworks and AI tooling.' },
]
---

<Main title="Page not found · c2n web components" description="The page you were looking for does not exist.">
  <div class="not-found">
    <StatusPanel client:load class="not-found__panel" media="illustration" heading-level={1}>
      <NotFoundSymbol client:load slot="media" />
      <span slot="title">This page wandered off</span>
      <span slot="description">
        The link may be broken, or the page may have moved when the docs were reorganised. Search for a component, or start from one of the sections below.
      </span>
      <div slot="actions" class="not-found__actions">
        <SiteButton href={`${base}/`}>Back to home</SiteButton>
        <SiteButton variant="ghost" data-open-search>
          <FeatherSearchIcon client:load slot="prefix-icon" />
          Search components
        </SiteButton>
      </div>
    </StatusPanel>

    <nav class="not-found__links" aria-label="Popular sections">
      {
        destinations.map(({ href, title, description }) => (
          <a class="not-found__link" href={href}>
            <span class="not-found__link-title">{title}</span>
            <span class="not-found__link-description">{description}</span>
          </a>
        ))
      }
    </nav>
  </div>
</Main>

<style lang="scss">
  .not-found {
    max-width: var(--site-page-max-width);
    margin: 0 auto;
    padding: 48px var(--site-gutter) 72px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;

    :global(.not-found__panel) {
      --c2-status-panel__container--min-height: 0;
      --c2-status-panel__container--padding: 24px 0 0;
      --c2-status-panel__illustration--size: 168px;
      --c2-status-panel__title--font-size: 28px;
      --c2-status-panel__title--line-height: 36px;
      --c2-status-panel__title--color: var(--site-color-on-surface);
      --c2-status-panel__description--font-size: 15px;
      --c2-status-panel__description--line-height: 24px;
      --c2-status-panel__description--color: var(--site-color-on-surface-variant);
      --c2-symbol--size: 168px;
    }

    &__actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
    }

    &__links {
      width: 100%;
      max-width: 720px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
      gap: 12px;
    }

    &__link {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 16px 18px;
      border: 1px solid var(--site-color-outline-variant);
      border-radius: var(--site-radius-md);
      background: var(--site-color-surface);
      color: inherit;
      text-decoration: none;
      transition:
        border-color 0.15s ease,
        background-color 0.15s ease;

      &:hover {
        border-color: var(--site-color-outline);
        background: var(--site-color-surface-container-2);
      }
      &:focus-visible {
        outline: 2px solid var(--site-color-primary);
        outline-offset: 2px;
      }
    }

    &__link-title {
      font-weight: 600;
      color: var(--site-color-on-surface);
    }

    &__link-description {
      font-size: 13.5px;
      color: var(--site-color-on-surface-variant);
    }
  }

  @media (max-width: 640px) {
    .not-found {
      padding-top: 24px;

      :global(.not-found__panel) {
        --c2-status-panel__illustration--size: 128px;
        --c2-symbol--size: 128px;
        --c2-status-panel__title--font-size: 22px;
        --c2-status-panel__title--line-height: 30px;
      }
    }
  }
</style>
