{
  "name": "@c2n/google-map",
  "version": "0.0.19",
  "private": true,
  "type": "module",
  "main": "dist/google-map.js",
  "exports": {
    ".": {
      "types": "./types/src/google-map.d.ts",
      "default": "./dist/google-map.js"
    },
    "./google-map-marker.js": {
      "types": "./types/src/google-map-marker.d.ts",
      "default": "./dist/google-map-marker.js"
    },
    "./google-map-route.js": {
      "types": "./types/src/google-map-route.d.ts",
      "default": "./dist/google-map-route.js"
    },
    "./google-street-view.js": {
      "types": "./types/src/google-street-view.d.ts",
      "default": "./dist/google-street-view.js"
    },
    "./google-maps-loader.js": {
      "types": "./types/src/google-maps-loader.d.ts",
      "default": "./dist/google-maps-loader.js"
    },
    "./geo.js": {
      "types": "./types/src/geo.d.ts",
      "default": "./dist/geo.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "dist",
    "types",
    "custom-elements.json",
    "react.d.ts",
    "react.js",
    "vue.d.ts",
    "vue.js"
  ],
  "keywords": [
    "google-map",
    "google maps",
    "map",
    "street view",
    "directions",
    "route",
    "web component",
    "lit"
  ],
  "license": "MIT",
  "author": "code2nguyen@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/code2nguyen/web-components.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "wireit",
    "build:only": "vite build",
    "type-check": "wireit"
  },
  "wireit": {
    "type-check": {
      "dependencies": [
        "../../core:build"
      ],
      "command": "tsc -p tsconfig.lib.json --composite false"
    },
    "build": {
      "dependencies": [
        "type-check"
      ],
      "command": "vite build"
    }
  },
  "dependencies": {
    "@c2n/core": "*",
    "lit": "3.3.3",
    "@types/google.maps": "^3.66.4"
  },
  "devDependencies": {
    "@c2n/config": "*"
  },
  "customElements": "custom-elements.json"
}
