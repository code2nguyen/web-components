---
/**
 * Plays the application's part in the trace-waterfall gallery: the French of the En français card, under `lang="fr"`.
 */
---

<script>
  import { addTranslations } from '@c2n/core/localize.js'

  addTranslations({
    fr: {
      'trace-waterfall': {
        label: 'Trace',
        empty: 'Aucun span',
        error: 'Erreur',
      },
    },
  })
</script>
