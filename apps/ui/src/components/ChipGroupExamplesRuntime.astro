---
/**
 * Plays the application's part in the chip-group gallery: the French of the En français card, under `lang="fr"`.
 */
---

<script>
  import { addTranslations } from '@c2n/core/localize.js'

  addTranslations({
    fr: {
      'chip-group': {
        more: '{0} de plus',
        collapse: 'Afficher moins',
      },
    },
  })
</script>
