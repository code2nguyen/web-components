---
import Main from '../../../layouts/Main.astro'
import DocComponentLayout from '../../../layouts/DocComponentLayout.astro'
import ApiTable from '../../../components/ApiTable.astro'
import { getCollection, getEntry } from 'astro:content'
import { componentManifests } from '../../../store/component-manifests'
import { countGalleryExamples } from '../../../utils/gallery'
import { renderManifestDescription } from '../../../utils/manifest-description'

/** API reference for a component (attributes, slots, events, CSS parts and custom properties) from its custom-elements manifest. */
export async function getStaticPaths() {
  const componentEntries = await getCollection('components')
  return componentEntries.map((entry) => ({
    params: { componentId: entry.id },
    props: { component: entry },
  }))
}

const { component } = Astro.props
// Most packages are named after their element; one whose name is not a tag names its primary one instead.
const componentTag = component.data.tag ?? `c2-${component.id}`
const manifest = componentManifests[componentTag]
if (!manifest) throw new Error(`No custom-elements manifest registered for ${componentTag} (see src/store/component-manifests.ts)`)
const gallery = await getEntry('gallery', component.id)

// One API table per element of the package (`c2-tabs` + `c2-tab`, `c2-radio` + `c2-radio-group`); the page's own tag first.
// A page may name the set itself — the five `@c2n/chart` pages each document one chart plus `c2-chart-series`.
const apiTags = component.data.apiTags ?? [componentTag, ...manifest.siblingTags]
const elements = apiTags.map((tag, index) => ({
  tag,
  manifest: componentManifests[tag],
  idPrefix: index === 0 ? 'api' : `api-${tag}`,
}))
const multiple = elements.length > 1

// The API table renders one <h3> per non-empty section; mirror them in the TOC (nested under the element when there are several).
type Heading = { depth: number; slug: string; text: string }
const headings = elements.flatMap(({ tag, manifest, idPrefix }) =>
  [
    multiple && { depth: 2, slug: idPrefix, text: tag },
    manifest.attributes.length > 0 && { depth: multiple ? 3 : 2, slug: `${idPrefix}-attributes`, text: 'Attributes' },
    manifest.slots.length > 0 && { depth: multiple ? 3 : 2, slug: `${idPrefix}-slots`, text: 'Slots' },
    manifest.events.length > 0 && { depth: multiple ? 3 : 2, slug: `${idPrefix}-events`, text: 'Events' },
    manifest.cssParts.length > 0 && { depth: multiple ? 3 : 2, slug: `${idPrefix}-parts`, text: 'CSS parts' },
    manifest.cssProperties.length > 0 && { depth: multiple ? 3 : 2, slug: `${idPrefix}-css`, text: 'CSS custom properties' },
  ].filter((heading): heading is Heading => Boolean(heading)),
)
---

<Main title={`${component.data.title} API · c2n web components`} description={component.data.description} withSidebar section="components">
  <DocComponentLayout
    componentId={component.id}
    headings={headings}
    title={component.data.title}
    description={component.data.description}
    view="api"
    galleryCount={gallery ? countGalleryExamples(gallery.body) : undefined}
  >
    {
      elements.map(({ tag, manifest, idPrefix }) => (
        <section class="api-element">
          {multiple && (
            <h2 id={idPrefix} class="api-element__title">
              <code>{tag}</code>
            </h2>
          )}
          {multiple && <p class="api-element__lead" set:html={renderManifestDescription(manifest.description)} />}
          <ApiTable componentTag={tag} idPrefix={idPrefix} />
        </section>
      ))
    }
  </DocComponentLayout>
</Main>

<style lang="scss">
  .api-element + .api-element {
    margin-top: 48px;
  }
  .api-element__title {
    font-size: 20px;
    margin: 0 0 8px;
    code {
      font-size: 18px;
    }
  }
  .api-element__lead {
    margin: 0;
    color: var(--site-color-on-surface-variant);
    font-size: 14px;
    line-height: 1.6;
  }
</style>
