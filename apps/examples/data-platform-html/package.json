{
  "name": "@c2n/example-data-platform-html",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "wireit",
    "type-check": "wireit"
  },
  "wireit": {
    "type-check": {
      "dependencies": [
        "../../../packages/core:build",
        "../../../packages/umbrella:build",
        "../../../packages/icons/feather-icons:build"
      ],
      "command": "tsc -p tsconfig.lib.json --composite false"
    },
    "build": {
      "dependencies": [
        "type-check"
      ],
      "files": [
        "src/**",
        "index.html",
        "vite.config.ts",
        "tsconfig*.json"
      ],
      "output": [
        "dist/**"
      ],
      "command": "vite build"
    }
  },
  "dependencies": {
    "@c2n/components": "*",
    "@c2n/feather-icons": "*"
  },
  "devDependencies": {
    "@c2n/config": "*"
  }
}
