---
import Main from '../../layouts/Main.astro'

const articles = [
  {
    number: '01',
    title: 'Establish the Foundation Before Asking AI to Build a Large Application',
    href: '/blogs/vibe-coding-is-changing-who-builds-software/',
    status: 'Published',
    description: 'Large, complex applications need reusable components, global architecture and business context, AI skills, and specialist agents before features are composed.',
  },
  {
    number: '02',
    title: 'Build Reusable Components with AI, Then Compose the Application',
    href: undefined,
    status: 'Planned',
    description: 'A component-first workflow for asking AI to find, build, extend, and compose reusable components into larger features.',
  },
  {
    number: '03',
    title: 'A Component Library for Humans Isn’t Automatically a Library for AI',
    href: undefined,
    status: 'Planned',
    description: 'What agents need to discover, understand, compose, and customize components reliably.',
  },
  {
    number: '04',
    title: 'The Missing Layer: Skills, Workflows, and Review for AI Coding',
    href: undefined,
    status: 'Planned',
    description: 'Why coding agents need project context, reusable skills, clear workflows, and thoughtful review.',
  },
  {
    number: '05',
    title: 'Design Systems as Guardrails for AI-Built Applications',
    href: undefined,
    status: 'Planned',
    description: 'How tokens, accessible components, and consistent patterns can guide generated applications.',
  },
  {
    number: '06',
    title: 'What an AI-Ready Component Library Needs',
    href: undefined,
    status: 'Planned',
    description: 'A practical set of principles for component libraries built for people and their coding agents.',
  },
  {
    number: '07',
    title: 'Building c2n for the Way Software Is Being Built',
    href: undefined,
    status: 'Planned',
    description: 'What c2n provides today, where it still has gaps, and what we are learning as we build for AI-assisted development.',
  },
]
---

<Main
  title="Blogs · c2n web components"
  description="Articles about building applications with AI, agent workflows, design systems, and component libraries."
  section="blogs"
>
  <div class="blogs">
    <header class="blogs__header">
      <p class="blogs__eyebrow">Ideas and field notes</p>
      <h1>Building applications in the AI era</h1>
      <p class="blogs__intro">
        AI coding agents are changing how applications get built. This series looks at the tools, workflows, design systems, and component libraries we need to
        make that change work well.
      </p>
    </header>

    <section class="series" aria-labelledby="series-title">
      <div class="series__heading">
        <div>
          <p class="series__eyebrow">Article series</p>
          <h2 id="series-title">From vibe coding to agent-ready building blocks</h2>
        </div>
        <span class="series__count">{articles.length} articles planned</span>
      </div>

      <ol class="article-list">
        {articles.map((article) => (
          <li class="article-list__item">
            <span class="article-list__number" aria-hidden="true">{article.number}</span>
            <div class="article-list__content">
              <h3>{article.href ? <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}${article.href}`}>{article.title}</a> : article.title}</h3>
              <p>{article.description}</p>
            </div>
            <span class="article-list__status">{article.status}</span>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Main>

<style lang="scss">
  .blogs {
    max-width: 900px;
    margin: 0 auto;
    padding: 76px var(--site-gutter) 100px;
  }

  .blogs__header {
    max-width: 720px;
    margin-bottom: 64px;

    h1 {
      margin: 12px 0 20px;
      font-size: clamp(2.25rem, 5vw, 3.5rem);
      line-height: 1.08;
      letter-spacing: -0.035em;
      text-wrap: balance;
    }
  }

  .blogs__eyebrow,
  .series__eyebrow {
    margin: 0;
    color: var(--site-color-primary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .blogs__intro {
    max-width: 640px;
    margin: 0;
    color: var(--site-color-on-surface-variant);
    font-size: 1.15rem;
    line-height: 1.65;
  }

  .series__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;

    h2 {
      margin: 8px 0 0;
      font-size: clamp(1.35rem, 3vw, 1.8rem);
      letter-spacing: -0.025em;
      line-height: 1.2;
      text-wrap: balance;
    }
  }

  .series__count {
    flex: none;
    padding: 6px 10px;
    border: 1px solid var(--site-color-outline-variant);
    border-radius: 999px;
    color: var(--site-color-on-surface-variant);
    font-size: 0.78rem;
  }

  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--site-color-outline-variant);
  }

  .article-list__item {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    align-items: start;
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--site-color-outline-variant);
  }

  .article-list__number {
    padding-top: 2px;
    color: var(--site-color-on-surface-muted);
    font-family: var(--site-font-mono, monospace);
    font-size: 0.85rem;
  }

  .article-list__content {
    h3 {
      margin: 0 0 7px;
      font-size: 1.05rem;
      line-height: 1.35;
      letter-spacing: -0.01em;
    }

    h3 a {
      color: inherit;
      text-decoration: none;

      &:hover {
        color: var(--site-color-primary);
      }
    }

    p {
      max-width: 640px;
      margin: 0;
      color: var(--site-color-on-surface-variant);
      font-size: 0.92rem;
      line-height: 1.55;
    }
  }

  .article-list__status {
    padding-top: 3px;
    color: var(--site-color-on-surface-muted);
    font-size: 0.78rem;
  }

  @media (max-width: 640px) {
    .blogs {
      padding-top: 52px;
    }

    .blogs__header {
      margin-bottom: 48px;
    }

    .series__heading {
      align-items: start;
      flex-direction: column;
      gap: 12px;
    }

    .article-list__item {
      grid-template-columns: 32px minmax(0, 1fr);
      gap: 12px;
    }

    .article-list__status {
      grid-column: 2;
      padding-top: 0;
    }
  }
</style>
