{
  "name": "@c2n/pivot-table",
  "version": "1.0.20",
  "private": true,
  "type": "module",
  "main": "dist/pivot-table.js",
  "exports": {
    ".": {
      "types": "./types/src/pivot-table.d.ts",
      "default": "./dist/pivot-table.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "dist",
    "types",
    "custom-elements.json",
    "react.d.ts",
    "react.js",
    "vue.d.ts",
    "vue.js"
  ],
  "keywords": [
    "pivot table",
    "pivot grid",
    "crosstab",
    "web component",
    "lit"
  ],
  "license": "MIT",
  "author": "code2nguyen@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/code2nguyen/web-components.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "wireit",
    "build:only": "vite build",
    "type-check": "wireit"
  },
  "wireit": {
    "type-check": {
      "dependencies": [
        "../../core:build",
        "../menu:build"
      ],
      "command": "tsc -p tsconfig.lib.json --composite false"
    },
    "build": {
      "dependencies": [
        "type-check"
      ],
      "command": "vite build"
    }
  },
  "dependencies": {
    "@c2n/core": "*",
    "@c2n/menu": "*",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@c2n/config": "*"
  },
  "customElements": "custom-elements.json"
}
