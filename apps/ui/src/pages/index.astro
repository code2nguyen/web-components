---
import { getCollection } from 'astro:content'
import Main from '../layouts/Main.astro'
import ComponentGallery from '../components/ComponentGallery.astro'
import { componentPreviews } from '../data/component-previews'
import SiteButton from '../components/ui/SiteButton.astro'
import SiteCard from '../components/ui/SiteCard.astro'
import { FeatherArrowRightIcon, FeatherCpuIcon, FeatherLayersIcon, FeatherSlidersIcon } from '../components/ui/icons'

const base = import.meta.env.BASE_URL
const componentCount = (await getCollection('components')).length
// Gallery cards are the fences on each component's gallery page; rounded down so the hero reads "700+", not "841".
const variantCount = (await getCollection('gallery')).reduce((n, entry) => n + (entry.body?.match(/tag=MdxCodeBlock/g)?.length ?? 0), 0)
const roundDown = (n: number, step: number) => Math.floor(n / step) * step
const iconSets = (await getCollection('icons')).sort((a, b) => a.data.title.localeCompare(b.data.title))
---

<Main title="c2n web components" section="overview">
  <div class="home">
    <section class="hero">
      <p class="eyebrow">c2n web components</p>
      <h1 class="hero__title">Every building block your AI needs to ship a web app.</h1>
      <p class="hero__lead">
        {roundDown(componentCount, 10)}+ components and {roundDown(variantCount, 100)}+ ready-made variants, built with AI and for AI. Your coding agent reads
        the exact API of every element over MCP, then composes it into real apps. Works in any stack, themed with a few CSS variables.
      </p>
      <div class="hero__actions">
        <SiteButton href={`${base}/components/`} variant="primary">
          Browse components
          <FeatherArrowRightIcon client:load slot="suffix-icon" />
        </SiteButton>
        <SiteButton href={`${base}/getting-started/`} variant="ghost">Get started</SiteButton>
      </div>
      <ul class="hero__facts">
        <li>
          <FeatherLayersIcon client:load class="hero__fact-icon" />
          {roundDown(componentCount, 10)}+ components, {roundDown(variantCount, 100)}+ variants
        </li>
        <li>
          <FeatherCpuIcon client:load class="hero__fact-icon" />
          MCP server and agent skill
        </li>
        <li>
          <FeatherSlidersIcon client:load class="hero__fact-icon" />
          Any framework, themed with CSS variables
        </li>
      </ul>
    </section>

    <section class="section" id="components" aria-labelledby="components-title">
      <div class="section__header">
        <h2 id="components-title">Components</h2>
        <p>Every preview below is the real component. Open one to see its examples, API and an interactive theming panel.</p>
      </div>
      <ComponentGallery />
    </section>

    <section class="section" id="icons" aria-labelledby="icons-title">
      <div class="section__header">
        <h2 id="icons-title">Icons</h2>
        <p>Icon sets ship as separate packages. Every icon is a web component that inherits <code>currentColor</code>.</p>
      </div>
      <ul class="icon-teaser">
        {
          iconSets.map((set) => (
            <li>
              <SiteCard href={`${base}/icons/${set.id}`} class="icon-teaser__card">
                <span class="icon-teaser__preview">
                  <Fragment set:html={componentPreviews[set.id] ?? ''} />
                </span>
                <span class="icon-teaser__text">
                  <span class="icon-teaser__title">{set.data.title}</span>
                  <span class="icon-teaser__desc">{set.data.description}</span>
                </span>
                <FeatherArrowRightIcon client:load class="icon-teaser__arrow" />
              </SiteCard>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Main>

<style lang="scss">
  .home {
    max-width: var(--site-page-max-width);
    margin: 0 auto;
    padding: 0 var(--site-gutter) 96px;
  }

  .hero {
    padding: 96px 0 72px;
    max-width: 760px;
    &__title {
      margin: 12px 0 20px;
      font-size: clamp(2.2rem, 5vw, 3.4rem);
      line-height: 1.08;
      font-weight: 700;
      letter-spacing: -0.03em;
      text-wrap: balance;
    }
    &__lead {
      margin: 0 0 32px;
      font-size: 1.15rem;
      line-height: 1.6;
      color: var(--site-color-on-surface-variant);
      max-width: 620px;
    }
    &__actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }
    &__facts {
      list-style: none;
      margin: 40px 0 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 12px 28px;
      font-size: 14px;
      color: var(--site-color-on-surface-variant);
      li {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        :global(.hero__fact-icon) {
          color: var(--site-color-primary);
          --c2-feather-icon--size: 16px;
        }
      }
    }
  }

  .section {
    padding: 56px 0 0;
    scroll-margin-top: var(--site-header-height);
    &__header {
      margin-bottom: 32px;
      max-width: 620px;
      h2 {
        margin: 0 0 8px;
        font-size: 1.75rem;
        letter-spacing: -0.02em;
        font-weight: 700;
      }
      p {
        margin: 0;
        color: var(--site-color-on-surface-variant);
      }
    }
  }

  .icon-teaser {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
    li {
      display: flex;
    }
    :global(.icon-teaser__card) {
      flex: 1;
      --c2-card--padding-top: 12px;
      --c2-card--padding-right: 16px;
      --c2-card--padding-bottom: 12px;
      --c2-card--padding-left: 12px;
      --c2-card__hover--background: var(--site-color-surface-container-1);
      --c2-card__hover--box-shadow: none;
      // The card body is the link content: lay the three parts out as a row.
      :global(a),
      :global(.c2-card) {
        display: grid;
        grid-template-columns: 120px 1fr auto;
        align-items: center;
        gap: 16px;
      }
    }
    :global(.icon-teaser__arrow) {
      color: var(--site-color-on-surface-muted);
      --c2-feather-icon--size: 16px;
    }
    &__preview {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 64px;
      border-radius: var(--site-radius-md);
      background-color: var(--site-color-surface-container-2);
      color: var(--site-color-on-surface);
      :global(.preview-row) {
        gap: 10px !important;
        --c2-feather-icon--size: 20px;
        font-size: 20px !important;
      }
    }
    &__text {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    &__title {
      font-weight: 600;
      color: var(--site-color-on-surface);
    }
    &__desc {
      font-size: 13px;
      color: var(--site-color-on-surface-variant);
    }
  }

  @media (max-width: 959.98px) {
    .hero {
      padding: 56px 0 40px;
    }
  }
</style>
