  "files": [
    "dist",
    "types",
    "react.d.ts",
    "react.js",
    "vue.d.ts",
    "vue.js"
  ],
  "keywords": [
    "chart",
    "charts",
    "graph",
    "data visualization",
    "line chart",
    "gauge chart",
    "radar chart",
    "scatter plot",
    "candlestick chart",
    "sparkline",
    "uplot",
    "echarts",
    "web component",
    "lit"
  ],
  "license": "MIT",
  "author": "code2nguyen@gmail.com",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/code2nguyen/web-components.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "wireit",
    "build:only": "vite build",
    "type-check": "wireit"
  },
  "wireit": {
    "type-check": {
      "dependencies": [
        "../../core:build"
      ],
      "command": "tsc -p tsconfig.lib.json --composite false"
    },
    "build": {
      "dependencies": [
        "type-check"
      ],
      "command": "vite build"
    }
  },
  "dependencies": {
    "@c2n/core": "0.0.10",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@c2n/config": "*",
    "echarts": "^6.1.0",
    "uplot": "^1.6.32"
  },
  "customElements": "custom-elements.json",
  "peerDependencies": {
    "echarts": "^5.5.0 || ^6.0.0",
    "uplot": "^1.6.31"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    },
    "uplot": {
      "optional": true
    }
  }
