---
/**
 * Enhances table gallery examples whose property-only API (`loadChildren`, `renderDetail`, `renderEditor`, `rowRule`,
 * `isCellEditable`) cannot be expressed as an HTML attribute, wires the buttons of the editing cards' toolbars, and adds
 * the French an app would supply for the cards under `lang="fr"` (the table's filter, the facet list inside it, and
 * the flags of a flowsheet), and adds the next round to the flowsheet's "Next round" card.
 */
---

<script>
  import type { Table, TableRow } from '@c2n/components/table'
  import type { TreeTable } from '@c2n/components/table/tree-table'
  import type { Flowsheet } from '@c2n/components/table/flowsheet'
  import type { TableColumn } from '@c2n/components/table/table-column'
  import type { DurationInput } from '@c2n/components/duration-input'
  import type { Autocomplete } from '@c2n/components/autocomplete'
  import '@c2n/components/table'
  import '@c2n/components/table/group-table'
  import '@c2n/components/table/flowsheet'
  import '@c2n/components/table/tree-table'
  import '@c2n/components/table/allocation-grid'
  import '@c2n/components/progress'
  import '@c2n/components/pagination'
  import '@c2n/components/duration-input'
  import '@c2n/components/autocomplete'
  import '@c2n/components/button'
  import { addTranslations } from '@c2n/core/localize.js'

  addTranslations({
    fr: {
      table: {
        filterColumn: 'Filtrer {0}',
        filterBlank: '(Vides)',
        sortAscending: 'Trier de A à Z',
        sortDescending: 'Trier de Z à A',
        clearFilter: 'Effacer le filtre',
        previousValue: 'Avant : {0}',
        flagLow: 'B',
        flagHigh: 'H',
        flagCriticalLow: 'BB',
        flagCriticalHigh: 'HH',
        flagLowName: 'Bas',
        flagHighName: 'Élevé',
        flagCriticalLowName: 'Critique bas',
        flagCriticalHighName: 'Critique haut',
        flagRange: '{0}, normale {1}',
        allocationUnder: 'sous la capacité',
        allocationAt: 'à capacité',
        allocationOver: 'au-delà de la capacité',
        rowTotal: 'Total',
        currentTime: 'maintenant',
        selectRow: 'Sélectionner la ligne',
        selectAllRows: 'Tout sélectionner',
        selectionOptions: 'Options de sélection',
        selectPageRows: 'Sélectionner cette page ({0})',
        selectAllCount: 'Tout sélectionner ({0})',
        clearSelection: 'Effacer la sélection',
      },
      'facet-list': {
        clear: 'Effacer',
        clearLabel: 'Effacer {0}',
        search: 'Filtrer les valeurs',
        onlyText: 'Seul',
        only: 'Seulement {0}',
        exclude: 'Exclure {0}',
        include: 'Inclure {0}',
        excluded: '{0}, exclu',
        showAll: 'Tout afficher ({0})',
        showFewer: 'Afficher moins',
        noMatches: 'Aucune valeur',
      },
    },
  })

  // Each region's countries add up to the figures the region shows before it is opened, so the rollup agrees.
  const countries: Record<string, TableRow[]> = {
    emea: [
      { id: 'de', region: 'Germany', stores: 14, revenue: 1720000 },
      { id: 'fr', region: 'France', stores: 11, revenue: 1260000 },
      { id: 'uk', region: 'United Kingdom', stores: 10, revenue: 1190000 },
      { id: 'se', region: 'Sweden', stores: 7, revenue: 650000 },
    ],
    americas: [
      { id: 'us', region: 'United States', stores: 38, revenue: 4480000 },
      { id: 'ca', region: 'Canada', stores: 11, revenue: 1100000 },
      { id: 'br', region: 'Brazil', stores: 8, revenue: 730000 },
    ],
    apac: [
      { id: 'jp', region: 'Japan', stores: 12, revenue: 1210000 },
      { id: 'au', region: 'Australia', stores: 7, revenue: 640000 },
      { id: 'sg', region: 'Singapore', stores: 4, revenue: 290000 },
    ],
  }

  const initialized = new WeakSet<Table>()

  const action = (table: Table, name: string) => table.querySelector<HTMLElement & { disabled: boolean }>(`[data-action="${name}"]`)
  const amount = (value: unknown) => (typeof value === 'number' ? value : 0)

  /** The editable grid: the toolbar counts the changes and adds or reverts rows. */
  function editableGrid(table: Table) {
    const changes = table.querySelector('.changes')!
    let next = 5
    table.addEventListener('rows-change', () => {
      const { added, updated, removed } = table.getChanges()
      const count = added.length + updated.length + removed.length
      changes.textContent = count ? `${count} unsaved ${count === 1 ? 'change' : 'changes'}` : 'No changes'
    })
    action(table, 'add')?.addEventListener('click', async () => {
      const row = await table.addRow({ id: `T-${next++}`, task: '', estimate: null, status: 'todo', billable: false })
      table.scrollToIndex(table.rows.indexOf(row))
    })
    action(table, 'revert')?.addEventListener('click', () => table.revertChanges())
  }

  const DAYS = ['mon', 'tue', 'wed', 'thu', 'fri']

  /** The timesheet: durations typed in a c2-duration-input, row totals, missing days, locked rows, overtime. */
  function timesheet(table: Table) {
    const withTotal = (row: TableRow): TableRow => ({ ...row, total: DAYS.reduce((sum, day) => sum + amount(row[day]), 0) })
    table.rows = table.rows.map(withTotal)
    table.rowRule = ({ row }) => withTotal(row)
    table.isCellEditable = ({ row }) => row.status === 'draft'
    table.rowPart = ({ row }) => (row.status === 'draft' ? undefined : 'row-locked')
    // One editor element per edit, kept while the table re-renders so the text typed so far stays. An edit that ended
    // took its element out of the page, so a disconnected one belongs to an earlier edit.
    let editor: { row: TableRow; column: string; input: DurationInput; setDraft(value: unknown): void } | undefined
    for (const day of DAYS) {
      const column = table.querySelector<TableColumn>(`c2-table-column[field="${day}"]`)!
      column.renderEditor = ({ row, draft, setDraft, column }) => {
        if (editor?.input.isConnected && editor.row === row && editor.column === column.field) {
          // The same edit drawn again: its listeners report to the context of this call.
          editor.setDraft = setDraft
          return editor.input
        }
        const input = document.createElement('c2-duration-input')
        input.setAttribute('largest-unit', 'h')
        input.setAttribute('aria-label', `${column.header} hours`)
        // Fills the cell: no radius, a 2px ring for the border, and neither the icon nor the `= 1 hour` preview, which
        // a day column has no room for (the row total shows the result).
        input.style.cssText =
          'flex: 1; min-width: 0; --c2-duration-input--min-height: 100%; --c2-duration-input--border-radius: 0; --c2-duration-input__value--padding: 0 8px; --c2-duration-input__icon--size: 0px; --c2-duration-input__preview--font-size: 0px; --c2-duration-input__value--gap: 0px; --c2-duration-input__focus--border: 2px solid var(--c2-theme--color-primary, #0265dc)'
        input.value = typeof draft === 'number' ? Math.round(draft * 3600) : null
        const read = () => editor?.setDraft(input.value === null ? null : input.value / 3600)
        input.addEventListener('input', read)
        input.addEventListener('change', read)
        editor = { row, column: column.field, input, setDraft }
        return input
      }
      // Pasted `7:30` or `1h 30m` reads as hours too.
      column.parseValue = (text) => {
        const clock = /^(\d+):(\d{2})$/.exec(text)
        if (clock) return Number(clock[1]) + Number(clock[2]) / 60
        const units = /^(?:(\d+(?:\.\d+)?)h)?\s*(?:(\d+)m)?$/.exec(text)
        if (units && (units[1] || units[2])) return Number(units[1] ?? 0) + Number(units[2] ?? 0) / 60
        return text === '' ? null : Number(text)
      }
      // A workday with no hours on a project that has some that week is flagged, not refused.
      column.validate = ({ value, row }) => (value === null && amount(row.total) > 0 && row.status === 'draft' ? 'No hours on a workday' : undefined)
    }
    const total = table.querySelector<TableColumn>('c2-table-column[field="total"]')!
    total.renderSummary = ({ value }) => {
      const hours = amount(value)
      const overtime = Math.max(0, hours - 40)
      return overtime ? `${hours - overtime} + ${overtime} OT` : `${hours} h`
    }
    // The column children register after the first render: check the rows once the table knows them.
    void customElements.whenDefined('c2-table-column').then(async () => {
      await new Promise(requestAnimationFrame)
      await table.updateComplete
      await table.validate()
    })
    action(table, 'submit')?.addEventListener('click', () => {
      table.rows = table.rows.map((row) => (row.status === 'draft' ? { ...row, status: 'submitted' } : row))
      table.acceptChanges()
      void table.validate()
    })
  }

  const PRODUCTS = [
    { name: 'Standing desk frame', sku: 'DSK-200', price: 490, tax: 'std' },
    { name: 'Desk top, oak 160 cm', sku: 'TOP-160', price: 310, tax: 'std' },
    { name: 'Monitor arm', sku: 'ARM-31', price: 89, tax: 'std' },
    { name: 'Cable tray', sku: 'CBL-07', price: 24, tax: 'std' },
    { name: 'Assembly and install', sku: 'SVC-INS', price: 120, tax: 'reduced' },
    { name: 'Ergonomic assessment', sku: 'SVC-ERG', price: 180, tax: 'zero' },
  ]
  const TAX: Record<string, { label: string; rate: number }> = {
    std: { label: 'VAT 20%', rate: 0.2 },
    reduced: { label: 'VAT 5.5%', rate: 0.055 },
    zero: { label: 'Exempt', rate: 0 },
  }

  /** A small button for a row's own actions, made as a node: a renderer's output sits in the table's shadow root. */
  function rowButton(label: string, text: string, onClick: () => void) {
    const button = document.createElement('c2-button')
    button.setAttribute('aria-label', label)
    button.textContent = text
    button.style.cssText = [
      '--c2-button__container--height: 26px',
      '--c2-button__container--padding-left: 7px',
      '--c2-button__container--padding-right: 7px',
      '--c2-button__container--background-color: transparent',
      '--c2-button__container--color: var(--c2-theme--color-on-surface-variant, #52525b)',
      '--c2-button__container__hover--background-color: var(--c2-theme--color-surface-container, #f4f4f5)',
      '--c2-button__container__active--background-color: color-mix(in srgb, var(--c2-theme--color-on-surface, #18181b) 12%, var(--c2-theme--color-surface, #ffffff))',
    ].join(';')
    button.addEventListener('click', onClick)
    return button
  }

  /** The line items editor: a product lookup, a computed line total, sections, row actions and the tax block. */
  function lineItems(table: Table) {
    const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' })
    const total = (row: TableRow) => Math.round(amount(row.qty) * amount(row.price) * (1 - amount(row.discount) / 100) * 100) / 100
    // Picking a product fills its SKU, price and tax code; any change recomputes the line total.
    table.rowRule = ({ row, field, value }) => {
      const product = field === 'product' ? PRODUCTS.find((entry) => entry.name === value) : undefined
      const next = product ? { ...row, sku: product.sku, price: product.price, tax: product.tax, qty: row.qty ?? 1 } : row
      return { ...next, total: total(next) }
    }
    let lookup: { row: TableRow; input: Autocomplete; setDraft(value: unknown): void; commit(value: unknown): void } | undefined
    table.querySelector<TableColumn>('c2-table-column[field="product"]')!.renderEditor = ({ row, draft, setDraft, commit }) => {
      if (lookup?.input.isConnected && lookup.row === row) {
        // The same edit drawn again: its listeners report to the context of this call.
        Object.assign(lookup, { setDraft, commit })
      } else {
        const input = document.createElement('c2-autocomplete')
        input.setAttribute('aria-label', 'Product')
        input.setAttribute('label-field', 'name')
        input.setAttribute('description-field', 'sku')
        input.suggestions = PRODUCTS
        input.value = String(draft ?? '')
        input.style.cssText = 'flex: 1; min-width: 0'
        input.addEventListener('input', () => lookup?.setDraft(input.value))
        input.addEventListener('suggestion-select', (event) => lookup?.commit((event as CustomEvent<{ item: { name: string } }>).detail.item.name))
        lookup = { row, input, setDraft, commit }
      }
      return lookup.input
    }
    // Each line moves within its section or goes: the table's own methods, called from the row's buttons.
    // The lines of a section need not sit next to each other in `rows` (a line added later is at the end): swap with
    // the neighbour the section shows.
    const move = (row: TableRow, step: number) => {
      const rows = [...table.rows]
      const section = rows.filter((entry) => entry.section === row.section)
      const neighbour = section[section.indexOf(row) + step]
      if (!neighbour) return
      const from = rows.indexOf(row)
      const to = rows.indexOf(neighbour)
      ;[rows[from], rows[to]] = [rows[to], rows[from]]
      table.rows = rows
    }
    table.querySelector<TableColumn>('c2-table-column[column-id="actions"]')!.renderCell = ({ row }) => {
      const box = document.createElement('span')
      box.style.cssText = 'display: inline-flex; gap: 2px'
      box.append(
        rowButton(`Move ${row.product || 'line'} up`, '↑', () => move(row, -1)),
        rowButton(`Move ${row.product || 'line'} down`, '↓', () => move(row, 1)),
        rowButton(`Remove ${row.product || 'line'}`, '✕', () => void table.deleteRows([row])),
      )
      return box
    }
    const footer = table.querySelector<HTMLElement>('.totals')!
    const update = () => {
      const subtotal = table.rows.reduce((sum, row) => sum + amount(row.total), 0)
      const taxes = new Map<string, number>()
      for (const row of table.rows) taxes.set(String(row.tax), (taxes.get(String(row.tax)) ?? 0) + amount(row.total) * (TAX[String(row.tax)]?.rate ?? 0))
      footer.replaceChildren()
      const line = (text: string, strong = false) => {
        const element = document.createElement(strong ? 'strong' : 'span')
        element.textContent = text
        footer.append(element)
      }
      line(`Subtotal ${money.format(subtotal)}`)
      for (const [code, tax] of taxes) if (tax) line(`${TAX[code]?.label ?? code} ${money.format(tax)}`)
      line(`Total ${money.format(subtotal + [...taxes.values()].reduce((sum, tax) => sum + tax, 0))}`, true)
    }
    table.addEventListener('rows-change', update)
    update()
    let next = 4
    action(table, 'add')?.addEventListener('click', () =>
      table.addRow({ id: `L${next++}`, section: 'Hardware', product: '', qty: 1, discount: 0, tax: 'std', total: 0 }),
    )
  }

  /** The allocation editor: percent and amount kept in step both ways, and both totals must reach their target. */
  function allocation(table: Table) {
    const whole = Number(table.dataset.amount)
    const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' })
    const round = (value: number) => Math.round(value * 100) / 100
    table.rowRule = ({ row, field }) =>
      field === 'share'
        ? { ...row, amount: round((whole * amount(row.share)) / 100) }
        : field === 'amount'
          ? { ...row, share: round((amount(row.amount) / whole) * 100) }
          : row
    const remainder = table.querySelector<HTMLElement>('.remainder')!
    const update = () => {
      const left = round(whole - table.rows.reduce((sum, row) => sum + amount(row.amount), 0))
      remainder.toggleAttribute('data-done', left === 0)
      remainder.textContent = left === 0 ? 'Fully allocated' : left > 0 ? `${money.format(left)} left to allocate` : `${money.format(-left)} over the invoice`
    }
    table.addEventListener('rows-change', update)
    update()
    // Splitting evenly gives the last line the cents the others round away, so the total is exact.
    const spread = (template: number[]) => {
      const rows = table.rows
      // Lines beyond the template get no share.
      const weights = rows.map((_, index) => template[index] ?? 0)
      const sum = weights.reduce((total, weight) => total + weight, 0)
      let given = 0
      let shared = 0
      table.rows = rows.map((row, index) => {
        const last = index === rows.length - 1
        const value = last ? round(whole - given) : round((whole * weights[index]) / sum)
        const share = last ? round(100 - shared) : round((value / whole) * 100)
        given += value
        shared += share
        return { ...row, amount: value, share }
      })
      update()
    }
    action(table, 'even')?.addEventListener('click', () => spread(table.rows.map(() => 1)))
    // A saved template: the shares by headcount, applied to the lines as they are.
    action(table, 'template')?.addEventListener('click', () => spread([12, 7, 21]))
    let next = 4
    action(table, 'add')?.addEventListener('click', () => table.addRow({ id: `A${next++}`, account: null, department: '', share: 0, amount: 0 }))
  }

  /** The journal entry: a line is a debit or a credit, and Post waits until the entry balances. */
  function journal(table: Table) {
    const balance = table.querySelector<HTMLElement>('.balance')!
    const post = action(table, 'post')!
    const debit = table.querySelector<TableColumn>('c2-table-column[field="debit"]')!
    debit.validate = ({ row }) => (row.debit === null && row.credit === null ? 'Enter a debit or a credit' : undefined)
    table.rowRule = ({ row, field, value }) =>
      value === null ? row : field === 'debit' ? { ...row, credit: null } : field === 'credit' ? { ...row, debit: null } : row
    const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' })
    const update = async () => {
      const difference = table.rows.reduce((sum, row) => sum + amount(row.debit) - amount(row.credit), 0)
      const errors = await table.validate()
      const balanced = Math.abs(difference) < 0.005
      balance.toggleAttribute('data-balanced', balanced)
      balance.textContent = balanced ? 'Balanced' : `Out of balance by ${money.format(Math.abs(difference))}`
      post.disabled = !balanced || errors.length > 0
    }
    table.addEventListener('rows-change', update)
    void update()
    action(table, 'add')?.addEventListener('click', () => table.addRow({ account: null, memo: '', debit: null, credit: null }))
    post.addEventListener('click', () => {
      table.acceptChanges()
      balance.textContent = 'Posted'
      post.disabled = true
    })
  }

  /** The "Next round" card: its toolbar button adds the 4:00 PM column, which the nurse then types into. */
  function nextRound(sheet: Flowsheet) {
    const add = sheet.querySelector<HTMLElement & { disabled: boolean }>('[data-add-round]')
    add?.addEventListener('click', async () => {
      await sheet.addTime('2026-11-14T16:00')
      add.disabled = true
    })
  }

  /** The goal tree: a `c2-progress` bar per row, the objectives showing the mean of their key results. */
  function goalTree(table: Table) {
    const column = table.querySelector<TableColumn>('c2-table-column[field="progress"]')
    if (!column) return
    column.renderCell = ({ row, value }) => {
      const bar = document.createElement('c2-progress')
      bar.setAttribute('value', String(Math.round(Number(value) || 0)))
      bar.setAttribute('show-value', '')
      bar.setAttribute('label', `${String(row.goal)}: progress`)
      return bar
    }
  }

  /** The gradebook: a mark beside a score (late, missing, excused) and a failing score become part names. */
  function gradebook(table: Table) {
    table.cellPart = ({ row, column, value }) => {
      const mark = (row.marks as Record<string, string> | undefined)?.[column.field]
      return [mark ? `cell-${mark}` : '', typeof value === 'number' && value < 60 ? 'cell-failing' : ''].filter(Boolean)
    }
  }

  /** The paged allocation grid: twelve people, a page at a time, after a short delay that stands in for the network. */
  function allocationSource(table: Table) {
    const weeks = ['2026-11-09', '2026-11-16', '2026-11-23']
    const names = ['Ada', 'Grace', 'Alan', 'Radia', 'Barbara', 'Katherine', 'Edsger', 'Margaret', 'Donald', 'Frances', 'Ken', 'Lynn']
    const people = names.map((name, index) => ({
      id: `p${index}`,
      name,
      allocations: Object.fromEntries(weeks.map((week, offset) => [week, 24 + ((index * 7 + offset * 5) % 24)])),
    }))
    table.dataSource = {
      getRows: ({ start, count }) => new Promise((resolve) => setTimeout(() => resolve({ rows: people.slice(start, start + count), total: people.length }), 600)),
    }
  }

  /** The bulk selection card: its toolbar says how many invoices the selection holds and how they were chosen. */
  function bulkSelect(table: Table) {
    const status = table.querySelector<HTMLElement>('[data-bulk-status]')
    table.addEventListener('selection-change', (event) => {
      if (!status) return
      const { value, scope } = event.detail
      status.textContent =
        value.length === 0 ? 'No invoices selected' : scope === 'all' ? `All ${value.length} invoices selected` : scope === 'page' ? `${value.length} invoices on this page selected` : `${value.length} selected`
    })
  }

  function setup() {
    document
      .querySelectorAll<Table>(
        'c2-table[data-table-example], c2-group-table[data-table-example], c2-tree-table[data-table-example], c2-flowsheet[data-table-example], c2-allocation-grid[data-table-example]',
      )
      .forEach((table) => {
        if (initialized.has(table)) return
        initialized.add(table)
        if (table.dataset.tableExample === 'lazy-children') {
          // A short delay stands in for the network, so the spinner on the chevron shows.
          ;(table as TreeTable).loadChildren = ({ key }) => new Promise((resolve) => setTimeout(() => resolve(countries[key] ?? []), 700))
        }
        if (table.dataset.tableExample === 'editable') editableGrid(table)
        if (table.dataset.tableExample === 'timesheet') timesheet(table)
        if (table.dataset.tableExample === 'journal') journal(table)
        if (table.dataset.tableExample === 'line-items') lineItems(table)
        if (table.dataset.tableExample === 'allocation') allocation(table)
        if (table.dataset.tableExample === 'next-round') nextRound(table as Flowsheet)
        if (table.dataset.tableExample === 'goal-tree') goalTree(table)
        if (table.dataset.tableExample === 'gradebook') gradebook(table)
      if (table.dataset.tableExample === 'bulk-select') bulkSelect(table)
      if (table.dataset.tableExample === 'allocation-source') allocationSource(table)
        if (table.dataset.tableExample === 'row-detail') {
          // A node rather than a Lit template: the panel is in the table's shadow root, so it is styled inline.
          table.renderDetail = ({ row }) => {
            const note = document.createElement('p')
            note.textContent = String(row.note)
            note.style.cssText = 'margin: 0; font-size: 13px; line-height: 1.5; max-width: 60ch'
            return note
          }
        }
      })
  }

  setup()
  const observer = new MutationObserver(setup)
  observer.observe(document.documentElement, { childList: true, subtree: true })
  document.addEventListener('astro:page-load', setup)
</script>
