---
import { getCollection } from 'astro:content'
import Main from '../../layouts/Main.astro'
import DocComponentLayout from '../../layouts/DocComponentLayout.astro'
import SiteCard from '../../components/ui/SiteCard.astro'
import { FeatherArrowRightIcon } from '../../components/ui/icons'
import { componentPreviews } from '../../data/component-previews'

const base = import.meta.env.BASE_URL
const iconSets = (await getCollection('icons')).sort((a, b) => a.data.title.localeCompare(b.data.title))
---

<Main title="Icons · c2n web components" withSidebar section="icons">
  <DocComponentLayout section="icons">
    <h1>Icons</h1>
    <p>
      Icon sets are packaged separately from UI components. Each set wraps an upstream icon library as web components that inherit
      <code>currentColor</code> and are sized through CSS custom properties, so they drop into any component slot.
    </p>
    <ul class="icon-sets">
      {
        iconSets.map((set) => (
          <li>
            <SiteCard href={`${base}/icons/${set.id}`} class="icon-sets__card">
              <div slot="media" class="icon-sets__preview">
                <Fragment set:html={componentPreviews[set.id] ?? ''} />
              </div>
              <span class="icon-sets__title">
                {set.data.title}
                <FeatherArrowRightIcon client:load class="site-card__arrow" />
              </span>
              <span class="icon-sets__desc">{set.data.description}</span>
              <code class="icon-sets__pkg">{set.data.package ?? `@c2n/${set.id}`}</code>
            </SiteCard>
          </li>
        ))
      }
    </ul>
  </DocComponentLayout>
</Main>

<style lang="scss">
  .icon-sets {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;

    li {
      display: flex;
    }
    :global(.icon-sets__card) {
      flex: 1;
      --c2-card__hover--background: var(--site-color-surface-container-1);
      :global(.site-card__media) {
        border-radius: var(--site-radius-lg) var(--site-radius-lg) 0 0;
        overflow: hidden;
        border-bottom: 1px solid var(--site-color-outline-variant);
      }
    }
    &__preview {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 120px;
      background-color: var(--site-color-surface-container-1);
      background-image: radial-gradient(var(--site-canvas-dot) 1px, transparent 1px);
      background-size: 16px 16px;
      color: var(--site-color-on-surface);
    }
    &__title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-weight: 600;
      color: var(--site-color-on-surface);
    }
    &__desc {
      display: block;
      margin: 4px 0;
      font-size: 13px;
      color: var(--site-color-on-surface-variant);
    }
    &__pkg {
      font-size: 11.5px;
      color: var(--site-color-on-surface-muted);
      background: transparent !important;
      padding: 0 !important;
    }
  }
</style>

<script>
  import '@c2n/feather-icons/icons/heart.js'
  import '@c2n/feather-icons/icons/camera.js'
  import '@c2n/feather-icons/icons/settings.js'
  import '@c2n/feather-icons/icons/arrow-right.js'
  import '@c2n/mat-icon'
  import '@fontsource/material-icons'
</script>
