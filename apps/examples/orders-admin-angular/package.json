{
  "name": "@c2n/example-orders-admin-angular",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ng serve",
    "build": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "../../../packages/core:build",
        "../../../packages/components/badge:build",
        "../../../packages/components/button:build",
        "../../../packages/components/card:build",
        "../../../packages/components/list-item:build",
        "../../../packages/components/modal:build",
        "../../../packages/components/select:build",
        "../../../packages/components/table:build",
        "../../../packages/components/tabs:build",
        "../../../packages/components/text-field:build",
        "../../../packages/components/toast:build",
        "../../../packages/tools/theme:build"
      ],
      "files": [
        "src/**",
        "angular.json",
        "tsconfig*.json"
      ],
      "output": [
        "dist/**"
      ],
      "command": "ng build"
    }
  },
  "dependencies": {
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@c2n/badge": "*",
    "@c2n/button": "*",
    "@c2n/card": "*",
    "@c2n/list-item": "*",
    "@c2n/modal": "*",
    "@c2n/select": "*",
    "@c2n/table": "*",
    "@c2n/tabs": "*",
    "@c2n/text-field": "*",
    "@c2n/theme": "*",
    "@c2n/toast": "*",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@c2n/config": "*"
  }
}
