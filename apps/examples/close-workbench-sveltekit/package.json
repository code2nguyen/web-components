{
  "name": "@c2n/example-close-workbench-sveltekit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "wireit",
    "type-check": "wireit",
    "test:unit": "node --test test/unit/*.test.ts",
    "test:browser": "playwright test --config playwright.config.ts",
    "preview": "vite preview"
  },
  "wireit": {
    "type-check": {
      "dependencies": [
        "../../../packages/core:build",
        "../../../packages/umbrella:build",
        "../../../packages/icons/feather-icons:build"
      ],
      "files": [
        "src/**",
        "test/**",
        "vite.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "output": [],
      "command": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
    },
    "build": {
      "dependencies": [
        "type-check"
      ],
      "files": [
        "src/**",
        "static/**",
        "vite.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "output": [
        "dist/**"
      ],
      "command": "vite build"
    }
  },
  "dependencies": {
    "@c2n/components": "*",
    "@c2n/core": "*",
    "@c2n/feather-icons": "*",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@c2n/config": "*",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7"
  }
}
