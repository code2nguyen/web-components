---
// ⌘K search, composed from c2 components: c2-modal (focus trap, Escape, backdrop, scroll lock, focus restore),
// c2-command (the query field, filtering, arrow-key highlight and Enter; rows are href links, grouped by section),
// c2-kbd (key hints) and c2-shortcut (⌘K / Ctrl+K, which also works while the user types in a field).
// Rendered as plain tags (registered by data/chrome-modules.ts): the palette is hidden until opened and has many rows,
// so SSR'ing every row as an island would only add weight. What stays ours: opening it and resetting the query.
import { getCollection } from 'astro:content'
import { escapeHtml, rawElement } from '../utils/raw-element'

type Entry = { href: string; title: string; meta: string; description: string; keywords: string }

const base = import.meta.env.BASE_URL
const components = (await getCollection('components')).sort((a, b) => a.data.title.localeCompare(b.data.title))
const iconSets = (await getCollection('icons')).sort((a, b) => a.data.title.localeCompare(b.data.title))
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order)
const groups: { heading: string; entries: Entry[] }[] = [
  {
    heading: 'Components',
    entries: components.map((c) => ({
      href: `${base}/components/${c.id}`,
      title: c.data.title,
      meta: c.data.category,
      description: c.data.description,
      keywords: `${c.data.description} ${c.data.category} c2-${c.id}`,
    })),
  },
  {
    heading: 'Icons',
    entries: iconSets.map((s) => ({
      href: `${base}/icons/${s.id}`,
      title: s.data.title,
      meta: 'Icons',
      description: s.data.description,
      keywords: `${s.data.description} icons c2-${s.id}`,
    })),
  },
  {
    heading: 'Guides',
    entries: guides.map((g) => ({
      href: `${base}/guides/${g.id}`,
      title: g.data.title,
      meta: 'Guide',
      description: g.data.description,
      keywords: `${g.data.description} guide`,
    })),
  },
]

// Raw HTML (see utils/raw-element.ts): written as tags, Astro would server-render these registered elements and drop
// `href` / `placeholder`, which are Lit properties. The row matches its label, `value` and `keywords`, so the
// description and category go into `keywords` to stay searchable.
const row = (entry: Entry) =>
  rawElement(
    'c2-command-item',
    { value: entry.href, href: entry.href, keywords: entry.keywords.toLowerCase() },
    `${escapeHtml(entry.title)}<span slot="description">${escapeHtml(entry.description)}</span><span slot="shortcut">${escapeHtml(entry.meta)}</span>`,
  )
const rows = groups.map((group) => rawElement('c2-command-group', { heading: group.heading }, group.entries.map(row).join(''))).join('')
const hint = (keys: string, text: string) => `<span class="search-palette__hint">${keys}${escapeHtml(text)}</span>`
const footer =
  `<div slot="footer" class="search-palette__footer">` +
  hint('<c2-kbd>↑</c2-kbd><c2-kbd>↓</c2-kbd>', 'navigate') +
  hint('<c2-kbd>↵</c2-kbd>', 'open') +
  hint('<c2-kbd>esc</c2-kbd>', 'close') +
  `</div>`
const command = rawElement(
  'c2-command',
  { class: 'search-palette__command', label: 'Search the documentation', placeholder: 'Search components…' },
  `<c2-feather-search slot="prefix-icon"></c2-feather-search>${rows}<span slot="empty">No components match.</span>${footer}`,
)
const shortcut = rawElement('c2-shortcut', {
  class: 'search-palette__shortcut',
  bindings: JSON.stringify([{ keys: 'mod+k', action: 'open-search', description: 'Search the documentation' }]),
})
const palette = rawElement('c2-modal', { class: 'search-palette', label: 'Search components', 'hide-close': true }, command)
---

<Fragment set:html={shortcut + palette} />

<style lang="scss" is:global>
  .search-palette {
    --c2-modal--width: min(600px, calc(100vw - 32px));
    --c2-modal--max-height: min(70vh, 560px);
    --c2-modal--margin-top: 10vh;
    --c2-modal--border: 1px solid var(--site-color-outline-variant);
    --c2-modal--border-top-left-radius: var(--site-radius-lg);
    --c2-modal--border-top-right-radius: var(--site-radius-lg);
    --c2-modal--border-bottom-left-radius: var(--site-radius-lg);
    --c2-modal--border-bottom-right-radius: var(--site-radius-lg);
    --c2-modal--box-shadow: var(--site-elevation-3);
    --c2-modal__body--padding-top: 0px;
    --c2-modal__body--padding-right: 0px;
    --c2-modal__body--padding-bottom: 0px;
    --c2-modal__body--padding-left: 0px;
    --c2-modal__backdrop--backdrop-filter: blur(2px);

    &__command {
      /* Fit the modal's content box (its max-height minus the 1px border) so the palette's list is the only
         scroller: the host is a flex column whose list shrinks, and the modal body never overflows. */
      max-height: calc(min(70vh, 560px) - 2px);
      --c2-command--background: transparent;
      --c2-command--color: var(--site-color-on-surface);
      --c2-command--border-top: none;
      --c2-command--border-right: none;
      --c2-command--border-bottom: none;
      --c2-command--border-left: none;
      --c2-command--border-top-left-radius: 0px;
      --c2-command--border-top-right-radius: 0px;
      --c2-command--border-bottom-left-radius: 0px;
      --c2-command--border-bottom-right-radius: 0px;
      --c2-command__field--min-height: 54px;
      --c2-command__field--font-size: 16px;
      --c2-command__field--padding-left: 16px;
      --c2-command__field--padding-right: 12px;
      --c2-command__field--border-bottom: 1px solid var(--site-color-outline-variant);
      --c2-command__placeholder--color: var(--site-color-on-surface-muted);
      --c2-command__icon--size: 18px;
      --c2-command__icon--color: var(--site-color-on-surface-muted);
      --c2-command__list--max-height: none;
      --c2-command__list--padding-top: 8px;
      --c2-command__list--padding-right: 8px;
      --c2-command__list--padding-bottom: 8px;
      --c2-command__list--padding-left: 8px;
      --c2-command__empty--color: var(--site-color-on-surface-muted);
      --c2-command__footer--border-top: 1px solid var(--site-color-outline-variant);
      --c2-command__footer--color: var(--site-color-on-surface-muted);
      --c2-command-group__heading--color: var(--site-color-on-surface-muted);
      --c2-command-group__heading--padding-left: 12px;
      --c2-command-item--padding-top: 10px;
      --c2-command-item--padding-bottom: 10px;
      --c2-command-item--padding-left: 12px;
      --c2-command-item--padding-right: 12px;
      --c2-command-item--color: var(--site-color-on-surface);
      --c2-command-item__active--background: var(--site-color-primary-soft);
      --c2-command-item__active--color: var(--site-color-primary);
      --c2-command-item__description--color: var(--site-color-on-surface-muted);
      --c2-command-item__shortcut--color: var(--site-color-on-surface-muted);
      --c2-kbd--min-width: 20px;
      --c2-kbd--height: 20px;
      --c2-kbd--font-size: 11px;
    }
    &__footer {
      display: flex;
      gap: 16px;
    }
    &__hint {
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
  }
</style>

<script>
  import '../data/chrome-modules'
  import type { Modal } from '@c2n/modal'
  import type { Command } from '@c2n/command'
  import type { Shortcut } from '@c2n/shortcut'

  const modal = document.querySelector<Modal>('.search-palette')
  const command = modal?.querySelector<Command>('.search-palette__command')

  function open() {
    if (!modal || modal.open) return
    command?.clear()
    modal.show()
  }

  // The modal fires `open` once the dialog is shown; focus the query then (the palette delegates focus to its field).
  modal?.addEventListener('open', () => command?.focus())

  document.querySelectorAll('[data-open-search]').forEach((button) => button.addEventListener('click', open))

  document.querySelector<Shortcut>('.search-palette__shortcut')?.addEventListener('shortcut', (event) => {
    if (event.detail.action === 'open-search') open()
  })
</script>
