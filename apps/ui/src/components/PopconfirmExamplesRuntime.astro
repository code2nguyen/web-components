---
/**
 * Plays the application's part in the popconfirm gallery: the French of the En français card, under `lang="fr"`.
 */
---

<script>
  import { addTranslations } from '@c2n/core/localize.js'

  addTranslations({
    fr: {
      popconfirm: {
        confirm: 'Valider',
        cancel: 'Annuler',
      },
    },
  })
</script>
