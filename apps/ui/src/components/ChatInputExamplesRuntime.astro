---
/**
 * Plays the application's part in the chat-input gallery: the French of the En français card, under `lang="fr"`.
 */
---

<script>
  import { addTranslations } from '@c2n/core/localize.js'

  addTranslations({
    fr: {
      'chat-input': {
        send: 'Envoyer le message',
      },
    },
  })
</script>
