---
import { getCollection } from 'astro:content'
import { COMPONENT_CATEGORIES, EXAMPLE_FRAMEWORKS, EXAMPLE_FRAMEWORK_LABELS } from '../schemas'
import SiteTextField from './ui/SiteTextField.astro'
import SiteIconButton from './ui/SiteIconButton.astro'
import { FeatherXIcon } from './ui/icons'
import { rawElement, escapeHtml } from '../utils/raw-element'

interface Props {
  /** Which section this sidebar navigates. */
  section?: 'components' | 'icons' | 'guides' | 'examples'
  /** Currently open entry id. */
  currentId?: string
  /** Places the filter and close control together at the top of the mobile drawer. */
  drawer?: boolean
}
const { section = 'components', currentId, drawer = false } = Astro.props
const base = import.meta.env.BASE_URL

const components = (await getCollection('components')).sort((a, b) => a.data.title.localeCompare(b.data.title))
const iconSets = (await getCollection('icons')).sort((a, b) => a.data.title.localeCompare(b.data.title))
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title))
const examples = (await getCollection('examples')).sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title))

const groups =
  section === 'components'
    ? COMPONENT_CATEGORIES.map((category) => {
        const categoryComponents = components.filter((component) => component.data.category === category)
        return {
          title: category,
          count: categoryComponents.length,
          items: [
            ...(category === 'Chart'
              ? [
                  {
                    id: 'chart-overview',
                    title: 'Overview',
                    href: `${base}/components/chart`,
                    search: 'chart overview architecture data engine legend tooltip realtime events states theming',
                  },
                ]
              : []),
            ...categoryComponents.map((c) => ({
              id: c.id,
              title: c.data.title,
              href: `${base}/components/${c.id}`,
              search: `${c.data.title} c2-${c.id} ${c.data.category}`,
            })),
          ],
        }
      }).filter((group) => group.items.length > 0)
    : section === 'icons'
      ? [{ title: 'Icon sets', items: iconSets.map((set) => ({ id: set.id, title: set.data.title, href: `${base}/icons/${set.id}`, search: set.data.title })) }]
      : section === 'examples'
        ? EXAMPLE_FRAMEWORKS.map((framework) => ({
            title: EXAMPLE_FRAMEWORK_LABELS[framework],
            items: examples
              .filter((example) => example.data.framework === framework)
              .map((e) => ({
                id: e.id,
                title: e.data.title,
                href: `${base}/examples/${e.id}`,
                search: `${e.data.title} ${EXAMPLE_FRAMEWORK_LABELS[framework]} ${e.data.tags.join(' ')}`,
              })),
          })).filter((group) => group.items.length > 0)
        : [
            {
              title: 'Guides',
              items: guides.map((guide) => ({ id: guide.id, title: guide.data.title, href: `${base}/guides/${guide.id}`, search: guide.data.title })),
            },
          ]

const overviews = {
  components: { href: `${base}/components/`, label: 'All components', noun: 'components' },
  icons: { href: `${base}/icons/`, label: 'All icon sets', noun: 'icon sets' },
  guides: { href: `${base}/guides/`, label: 'All guides', noun: 'guides' },
  examples: { href: `${base}/examples/`, label: 'All examples', noun: 'examples' },
}
const overview = overviews[section]
const total = section === 'components' ? components.length : groups.reduce((count, group) => count + group.items.length, 0)

// One group is just a list with a heading: nothing to collapse, nothing worth filtering.
const collapsible = groups.length > 1

/**
 * The nav as a `c2-tree`, emitted as a raw string.
 *
 * Two things force this shape. It must bypass `@astrojs/lit` (see `utils/raw-element.ts`): server-rendering 138
 * rows inlines the row stylesheet into a declarative shadow root per row, which took a component page from
 * 606 KB to 2.1 MB of HTML, and the rows arrived inert behind `defer-hydration`. And each row's link is slotted
 * into `label` rather than set as the item's `href`, so the anchors stay in the light DOM — they are the
 * internal link graph a crawler follows, and they keep the nav usable before the tree upgrades.
 */
const treeHtml = collapsible
  ? rawElement(
      'c2-tree',
      {
        class: 'sidebar__tree',
        'children-outline': true,
        selection: 'none',
        // A category row is a heading with nothing to select, and the row already shows a pointer cursor, so
        // the whole bar has to toggle it — hunting for the 14px chevron is the one thing the old
        // `c2-details` nav never made anyone do. Leaf rows are left alone (`expandOnClick` only fires on a
        // branch), so a page link still just navigates.
        'expand-on-click': true,
        'expanded-items': groups
          .filter((group) => group.items.some((item) => item.id === currentId))
          .map((group) => group.title)
          .join(';'),
      },
      groups
        .map((group) => {
          const count = 'count' in group ? group.count : group.items.length
          const rows = group.items
            .map((item) =>
              rawElement(
                'c2-tree-item',
                { value: item.id, class: 'sidebar__item', 'data-search': item.search.toLowerCase() },
                `<a slot="label" href="${escapeHtml(item.href)}"${item.id === currentId ? ' aria-current="page"' : ''}>${escapeHtml(item.title)}</a>`,
              ),
            )
            .join('')
          return rawElement(
            'c2-tree-item',
            { value: group.title, class: 'sidebar__group', 'data-group': group.title },
            `<span slot="label">${escapeHtml(group.title)}</span>` + `<span slot="actions" class="sidebar__count" data-total="${count}">${count}</span>` + rows,
          )
        })
        .join(''),
    )
  : ''
---

<nav
  class:list={['sidebar__nav', { 'sidebar__nav--drawer': drawer }]}
  data-section={section}
  aria-label={section === 'components' ? 'Components' : section === 'icons' ? 'Icon sets' : section === 'examples' ? 'Example apps' : 'Guides'}
>
  {
    collapsible && (
      <div class:list={['sidebar__filter', { 'sidebar__filter--drawer': drawer }]}>
        <SiteTextField
          class="sidebar__filter-field"
          label={`Filter ${overview.noun}`}
          search
          size="sm"
          hydrate="defined"
          placeholder={`Filter ${overview.noun}…`}
        />
        {drawer && (
          <SiteIconButton label="Close navigation" tooltip={false} size="sm" side-nav-toggle>
            <FeatherXIcon client:load />
          </SiteIconButton>
        )}
      </div>
    )
  }

  {
    drawer && !collapsible && (
      <div class="sidebar__drawer-actions">
        <SiteIconButton label="Close navigation" tooltip={false} size="sm" side-nav-toggle>
          <FeatherXIcon client:load />
        </SiteIconButton>
      </div>
    )
  }

  <a href={overview.href} class:list={['sidebar__overview', { active: !currentId }]}>
    <span>{overview.label}</span>
    <span class="sidebar__count">{total}</span>
  </a>

  {
    collapsible ? (
      <Fragment set:html={treeHtml} />
    ) : (
      // One group carries no information the "All …" link above it does not already give, so it goes unlabelled.
      <div class="sidebar__group">
        <ul class="sidebar__items">
          {groups[0].items.map((item) => (
            <li>
              <a href={item.href} data-search={item.search.toLowerCase()} aria-current={currentId === item.id ? 'page' : undefined}>
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    collapsible && (
      <p class="sidebar__empty" hidden>
        Nothing matches that filter.
      </p>
    )
  }
</nav>

<style lang="scss">
  .sidebar__nav {
    display: flex;
    flex-direction: column;
    font-size: 13.5px;
    padding-bottom: 32px;
  }

  // Stays put while the list scrolls under it, so the filter is always one click away.
  .sidebar__filter {
    position: sticky;
    top: 0;
    z-index: 1;
    // On desktop this extends the filter's opaque sticky surface through the navigation's top spacing,
    // while leaving the field itself at the same visual offset below the header.
    margin-top: calc(0px - var(--sidebar-filter-top-space, 0px));
    padding-top: var(--sidebar-filter-top-space, 0px);
    padding-bottom: 12px;
    background: var(--site-color-surface);

    &--drawer {
      display: flex;
      align-items: center;
      gap: 8px;
    }
  }

  .sidebar__filter-field {
    flex: 1;
    min-width: 0;
  }

  .sidebar__drawer-actions {
    display: flex;
    justify-content: flex-end;
    padding-bottom: 12px;
  }

  .sidebar__overview {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    margin-bottom: 10px;
    border-radius: var(--site-radius-sm);
    color: var(--site-color-on-surface-variant);
    font-weight: 500;
    > span:first-child {
      flex: 1;
    }
    &:hover {
      text-decoration: none;
      background: var(--site-color-surface-container-2);
      color: var(--site-color-on-surface);
    }
    &.active {
      color: var(--site-color-primary);
      background: var(--site-color-primary-soft);
    }
  }

  .sidebar__group[hidden] {
    display: none;
  }

  // c2-tree ships as a bordered card; a nav is the opposite of that. Everything here is one of its own
  // variables — no reaching into the shadow DOM.
  // These selectors target markup emitted through `set:html`, which never carries Astro's scope class, so
  // they have to be global. The class names are specific enough to stay contained.
  :global(.sidebar__tree) {
    display: block;
    --c2-tree--background: transparent;
    --c2-tree--padding-top: 0px;
    --c2-tree--padding-bottom: 0px;
    --c2-tree--border-top-left-radius: 0;
    --c2-tree--border-top-right-radius: 0;
    --c2-tree--border-bottom-left-radius: 0;
    --c2-tree--border-bottom-right-radius: 0;

    --c2-tree-item--font-size: 13px;
    --c2-tree-item--color: var(--site-color-on-surface-variant);
    --c2-tree-item__row--min-height: 28px;
    --c2-tree-item__row--indent: 15px;
    --c2-tree-item__row--padding-inline-start: 8px;
    --c2-tree-item__row--padding-inline-end: 8px;
    --c2-tree-item__row--border-radius: var(--site-radius-sm);
    --c2-tree-item__hover--background: var(--site-color-surface-container-2);
    --c2-tree-item__hover--color: var(--site-color-on-surface);
    --c2-tree-item__toggle--size: 14px;
    --c2-tree-item__toggle--color: var(--site-color-on-surface-muted);
    --c2-tree-item__focus--outline: 2px solid var(--site-color-primary);
    --c2-tree-item__guide--color: var(--site-color-outline-variant);
    // The counts belong to a group row permanently; they are not a hover affordance.
    --c2-tree-item__actions--opacity: 1;
  }

  // A category row is a heading, so it reads louder than the pages under it.
  :global(.sidebar__tree c2-tree-item.sidebar__group) {
    --c2-tree-item--color: var(--site-color-on-surface);
    --c2-tree-item--font-weight: 600;
  }

  // A group's overrides are custom properties, so they cascade into the rows nested inside it. Put the page
  // rows back to the quieter treatment they had as list links.
  :global(.sidebar__tree c2-tree-item.sidebar__item) {
    --c2-tree-item--color: var(--site-color-on-surface-variant);
    --c2-tree-item--font-weight: 400;
  }

  // The slotted anchor fills the row's label cell, so the click target is the whole row bar the toggle.
  :global(.sidebar__tree c2-tree-item.sidebar__item a) {
    display: block;
    color: inherit;
    text-decoration: none;
    &:hover {
      text-decoration: none;
    }
    &[aria-current='page'] {
      color: var(--site-color-primary);
      font-weight: 500;
    }
  }

  :global(.sidebar__tree c2-tree-item[hidden]) {
    display: none;
  }

  /* Before the tree upgrades the rows are plain unknown elements, so the nav degrades to the indented list of
     links it is built from — visible and clickable with no JS, rather than a blank panel. */
  :global(c2-tree:not(:defined)) {
    display: block;
    c2-tree-item {
      display: block;
    }
    c2-tree-item .sidebar__count {
      display: none;
    }
    [slot='label'] {
      display: block;
      padding: 4px 8px;
      font-size: 13px;
    }
    c2-tree-item c2-tree-item {
      margin-left: 15px;
    }
  }

  :global(.sidebar__count) {
    flex: none;
    font-size: 11px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--site-color-on-surface-muted);
  }

  .sidebar__items {
    list-style: none;
    display: flex;
    flex-direction: column;
    margin: 0 0 8px 15px;
    padding: 0;
    li[hidden] {
      display: none;
    }
  }
  // The rail is built from one segment per row, so the current row can thicken and colour its own piece of it.
  .sidebar__items a {
    display: block;
    padding: 4px 10px 4px 14px;
    border-left: 2px solid var(--site-color-outline-variant);
    border-radius: 0 var(--site-radius-sm) var(--site-radius-sm) 0;
    color: var(--site-color-on-surface-variant);
    &:hover {
      text-decoration: none;
      background: var(--site-color-surface-container-2);
      border-left-color: var(--site-color-outline);
      color: var(--site-color-on-surface);
    }
    &[aria-current='page'] {
      border-left-color: var(--site-color-primary);
      color: var(--site-color-primary);
      font-weight: 500;
    }
  }

  .sidebar__empty {
    margin: 4px 8px;
    color: var(--site-color-on-surface-muted);
  }
</style>

<script>
  import '../data/chrome-modules'

  type Nav = HTMLElement & { dataset: { section?: string } }
  type SidebarTree = HTMLElement & { expandedItems: string[]; updateComplete: Promise<unknown> }

  // Private browsing and blocked site data both make storage throw rather than return null.
  function read(key: string): string | null {
    try {
      return localStorage.getItem(key)
    } catch {
      return null
    }
  }
  function write(key: string, value: string): void {
    try {
      localStorage.setItem(key, value)
    } catch {
      /* not worth reporting: the groups simply open where they always did */
    }
  }

  /**
   * Collapsing and filtering, for every copy of the nav on the page — the desktop grid sidebar and the
   * `c2-side-nav` drawer render the same markup.
   */
  async function enhance(nav: Nav): Promise<void> {
    const tree = nav.querySelector<SidebarTree>('c2-tree.sidebar__tree')
    if (!tree) return
    // The tree ships as a plain tag and upgrades from `data/chrome-modules.ts`, so wait for the definition
    // before reading `expandedItems` off it.
    await customElements.whenDefined('c2-tree')
    await tree.updateComplete

    const key = `c2n-sidebar-groups:${nav.dataset.section ?? 'components'}`
    const groups = [...tree.querySelectorAll<HTMLElement>('c2-tree-item.sidebar__group')]
    const currentGroup = nav.querySelector<HTMLElement>('[aria-current="page"]')?.closest<HTMLElement>('c2-tree-item.sidebar__group')

    // Restore what the visitor left open, and always open the group they are actually in. The tree keeps one
    // array for this, so the stored value *is* the state — no per-group reconciliation.
    const stored = read(key)
    if (stored !== null) {
      const open = new Set(stored.split('\n').filter(Boolean))
      if (currentGroup?.dataset.group) open.add(currentGroup.dataset.group)
      tree.expandedItems = groups.map((group) => group.dataset.group ?? '').filter((title) => open.has(title))
      await tree.updateComplete
    }

    // Filtering forces groups open, so remember the real state to put back when the query is cleared.
    let filtering = false
    let restore: string[] = []

    tree.addEventListener('expansion-change', () => {
      if (filtering) return
      write(key, tree.expandedItems.join('\n'))
    })

    const field = nav.querySelector<HTMLElement & { value: string }>('.sidebar__filter-field')
    const empty = nav.querySelector<HTMLElement>('.sidebar__empty')
    if (!field) return

    const apply = () => {
      const query = field.value.trim().toLowerCase()
      if (query && !filtering) {
        filtering = true
        restore = [...tree.expandedItems]
      }

      let matches = 0
      const open: string[] = []
      for (const group of groups) {
        let visible = 0
        for (const item of group.querySelectorAll<HTMLElement>('c2-tree-item.sidebar__item')) {
          const hit = !query || item.dataset.search?.includes(query) === true
          // `hidden` also takes the row out of the tree's keyboard order, so Arrow Down skips filtered-out rows.
          item.hidden = !hit
          if (hit) visible += 1
        }
        group.hidden = visible === 0
        // A filtered group has to be open or its hits stay hidden inside it.
        if (query && visible > 0) open.push(group.dataset.group ?? '')
        // A group that says 11 while showing three rows reads as a bug.
        const count = group.querySelector<HTMLElement>('.sidebar__count')
        if (count) count.textContent = query ? String(visible) : (count.dataset.total ?? count.textContent)
        matches += visible
      }
      if (empty) empty.hidden = matches > 0

      if (query) {
        tree.expandedItems = open
      } else if (filtering) {
        filtering = false
        tree.expandedItems = restore
      }
    }

    field.addEventListener('input', apply)
    // A search input's native clear button fires `search`, not `input`, in Safari.
    field.addEventListener('search', apply)
    field.addEventListener('keydown', (event) => {
      if ((event as KeyboardEvent).key !== 'Escape' || !field.value) return
      event.stopPropagation()
      field.value = ''
      apply()
    })
  }

  for (const nav of document.querySelectorAll<Nav>('.sidebar__nav')) void enhance(nav)

  // The docs site is a plain MPA — every sidebar link is a full page load — so the sidebar's own scroll offset is
  // thrown away on each navigation unless we carry it across ourselves. Restore what the visitor left behind, and
  // only fall back to revealing the current entry when there is nothing to restore (first visit, deep link, or a
  // stored offset that would leave the current entry off screen).
  const sidebar = document.querySelector<HTMLElement>('.docs__sidebar')
  const nav = sidebar?.querySelector<HTMLElement>('.sidebar__nav')

  if (sidebar && nav) {
    const key = `c2n-sidebar-scroll:${nav.dataset.section ?? 'components'}`
    const current = nav.querySelector<HTMLElement>('a[aria-current="page"]')

    const readScroll = () => {
      try {
        // `Number(null)` is 0, which is indistinguishable from a visitor who really is at the top.
        const stored = sessionStorage.getItem(key)
        return stored === null ? NaN : Number(stored)
      } catch {
        return NaN
      }
    }
    const writeScroll = (value: number) => {
      try {
        sessionStorage.setItem(key, String(value))
      } catch {
        /* not worth reporting: the sidebar simply starts where it always did */
      }
    }

    const offsetOf = (el: HTMLElement) => el.getBoundingClientRect().top - sidebar.getBoundingClientRect().top + sidebar.scrollTop
    const currentIsVisible = () => {
      if (!current) return true
      const top = offsetOf(current) - sidebar.scrollTop
      return top >= 0 && top + current.offsetHeight <= sidebar.clientHeight
    }

    const restored = readScroll()
    const apply = () => {
      if (Number.isFinite(restored) && restored >= 0) {
        sidebar.scrollTop = restored
        if (currentIsVisible()) return
      }
      if (current) sidebar.scrollTop = Math.max(0, offsetOf(current) - sidebar.clientHeight / 2 + current.offsetHeight / 2)
    }

    // `scrollTop` clamps to the height the element has *right now*, and this runs before `c2-side-nav` (a
    // `client:load` island wrapping the whole grid) has hydrated — at which point the sidebar may not be scrollable
    // yet and the assignment silently collapses to 0. Re-apply once the layout has settled, but never fight a
    // visitor who has already started scrolling.
    let touched = false
    for (const event of ['wheel', 'touchstart', 'keydown'] as const) {
      window.addEventListener(event, () => (touched = true), { once: true, passive: true })
    }
    const applyUntilSettled = () => {
      if (!touched) apply()
    }

    apply()
    requestAnimationFrame(applyUntilSettled)
    customElements.whenDefined('c2-side-nav').then(() => requestAnimationFrame(applyUntilSettled))

    let frame = 0
    sidebar.addEventListener(
      'scroll',
      () => {
        if (frame) return
        frame = requestAnimationFrame(() => {
          frame = 0
          writeScroll(sidebar.scrollTop)
        })
      },
      { passive: true },
    )
  }
</script>
