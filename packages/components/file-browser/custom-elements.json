erItemDetail>"},"description":"The user opened a file (double-click or Enter)."},{"name":"selection-change","type":{"text":"CustomEvent<FileBrowserSelectionChangeDetail>"},"description":"The user changed the selection. Does not bubble."},{"name":"item-action","type":{"text":"CustomEvent<FileBrowserItemActionDetail>"},"description":"The user picked an action for the selected items."},{"name":"item-rename","type":{"text":"CustomEvent<FileBrowserItemRenameDetail>"},"description":"The user renamed an item in place."},{"name":"files-drop","type":{"text":"CustomEvent<FileBrowserFilesDropDetail>"},"description":"The user dropped files from the desktop."},{"name":"item-move","type":{"text":"CustomEvent<FileBrowserItemMoveDetail>"},"description":"The user dropped items on a folder."},{"name":"search","type":{"text":"CustomEvent<FileBrowserSearchDetail>"},"description":"With `search=\"remote\"`, the query to run."},{"name":"sort-change","type":{"text":"CustomEvent<FileBrowserSortChangeDetail>"},"description":"The user changed the sort order."},{"name":"view-change","type":{"text":"CustomEvent<FileBrowserViewChangeDetail>"},"description":"The user switched between the list and the grid."}],"attributes":[{"name":"items","type":{"text":"FileBrowserItem[]"},"default":"[]","description":"Every known folder and file, flat. JSON in markup.","fieldName":"items"},{"name":"folder","type":{"text":"string"},"default":"''","description":"The open folder's id; empty for the root.","fieldName":"folder"},{"name":"root-label","type":{"text":"string"},"default":"''","description":"The root folder's name. Defaults to the \"My files\" message.","fieldName":"rootLabel"},{"name":"label","type":{"text":"string"},"default":"''","description":"The browser's accessible name. Defaults to the \"Files\" message.","fieldName":"label"},{"name":"view","type":{"text":"FileBrowserView"},"default":"'list'","description":"`list` (the default) or `grid`.","fieldName":"view"},{"name":"sort","type":{"text":"FileBrowserSort"},"default":"'name'","description":"The column the items are sorted by. Folders always come first.","fieldName":"sort"},{"name":"sort-direction","type":{"text":"FileBrowserSortDirection"},"default":"'asc'","description":"`asc` (the default) or `desc`.","fieldName":"sortDirection"},{"name":"selection","type":{"text":"FileBrowserSelection"},"default":"'multiple'","description":"`multiple` (the default) or `single`.","fieldName":"selection"},{"name":"value","type":{"text":"string[]"},"default":"[]","description":"The selected ids.","fieldName":"value"},{"name":"actions","type":{"text":"FileBrowserAction[]"},"default":"[]","description":"The commands of the context menu and the selection bar. JSON in markup.","fieldName":"actions"},{"name":"search","type":{"text":"'local' | 'remote'"},"default":"'local'","description":"`local` (the default) filters the open folder by name; `remote` fires `search` for the app to answer.","fieldName":"search"},{"name":"locale","type":{"text":"string"},"default":"''","description":"The locale for dates and sizes; the nearest `lang` when empty.","fieldName":"locale"}],"superclass":{"name":"LitElement","package":"lit"},"tagName":"c2-file-browser","customElement":true}],"exports":[{"kind":"js","name":"fileCategory","declaration":{"name":"fileCategory","module":"./file-kind.js"}},{"kind":"js","name":"fileFormat","declaration":{"name":"fileFormat","module":"./file-kind.js"}},{"kind":"js","name":"FileCategory","declaration":{"name":"FileCategory","module":"./file-kind.js"}},{"kind":"js","name":"fileBrowserMessages","declaration":{"name":"fileBrowserMessages","module":"./messages.js"}},{"kind":"js","name":"FileBrowser","declaration":{"name":"FileBrowser","module":"src/file-browser.ts"}},{"kind":"custom-element-definition","name":"c2-file-browser","declaration":{"name":"FileBrowser","module":"src/file-browser.ts"}}]}]}