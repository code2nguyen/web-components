{
  "name": "@c2n/address-field",
  "version": "1.0.20",
  "private": true,
  "type": "module",
  "main": "dist/address-field.js",
  "exports": {
    ".": {
      "types": "./types/src/address-field.d.ts",
      "default": "./dist/address-field.js"
    },
    "./providers/google.js": {
      "types": "./types/src/providers/google.d.ts",
      "default": "./dist/providers/google.js"
    },
    "./providers/mapbox.js": {
      "types": "./types/src/providers/mapbox.d.ts",
      "default": "./dist/providers/mapbox.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "dist",
    "types",
    "custom-elements.json",
    "react.d.ts",
    "react.js",
    "vue.d.ts",
    "vue.js"
  ],
  "keywords": [
    "address",
    "address autocomplete",
    "checkout",
    "form",
    "web component",
    "lit"
  ],
  "license": "MIT",
  "author": "code2nguyen@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/code2nguyen/web-components.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "wireit",
    "build:only": "vite build",
    "type-check": "wireit"
  },
  "wireit": {
    "type-check": {
      "dependencies": [
        "../../core:build",
        "../form-field:build",
        "../text-field:build",
        "../select:build",
        "../list-item:build",
        "../autocomplete:build"
      ],
      "command": "tsc -p tsconfig.lib.json --composite false"
    },
    "build": {
      "dependencies": [
        "type-check"
      ],
      "command": "vite build"
    }
  },
  "dependencies": {
    "@c2n/autocomplete": "*",
    "@c2n/core": "*",
    "@c2n/form-field": "*",
    "@c2n/list-item": "*",
    "@c2n/select": "*",
    "@c2n/text-field": "*",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@c2n/config": "*"
  },
  "customElements": "custom-elements.json"
}
