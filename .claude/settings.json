{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm exec tsc --noEmit)",
      "Bash(pnpm exec tsc --noEmit *)",
      "Bash(node .claude/skills/modern-web-review/scripts/scan.mjs)",
      "Bash(node .claude/skills/modern-web-review/scripts/scan.mjs *)",
      "Bash(pnpm run test:type-check)",
      "Bash(pnpm run check:bundle-size)",
      "Bash(pnpm run format:check)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run check:agent-docs)",
      "Bash(pnpm run check:reachability)",
      "Bash(pnpm run check:app-markup)",
      "Bash(pnpm run check:component-template)",
      "Bash(pnpm run check:example-theme)",
      "Bash(pnpm run check:dogfood)",
      "mcp__c2n__get_component",
      "mcp__c2n__search_components",
      "mcp__c2n__validate_markup",
      "mcp__c2n__get_examples",
      "mcp__c2n__list_components",
      "mcp__c2n__search_examples",
      "mcp__c2n__get_theme"
    ]
  }
}
