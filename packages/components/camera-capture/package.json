{
  "name": "@c2n/camera-capture",
  "version": "1.0.23",
  "private": true,
  "type": "module",
  "main": "dist/camera-capture.js",
  "exports": {
    ".": {
      "types": "./types/src/camera-capture.d.ts",
      "default": "./dist/camera-capture.js"
    },
    "./camera.js": {
      "types": "./types/src/camera.d.ts",
      "default": "./dist/camera.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "dist",
    "types",
    "custom-elements.json",
    "react.d.ts",
    "react.js",
    "vue.d.ts",
    "vue.js"
  ],
  "keywords": [
    "camera-capture",
    "web component",
    "lit"
  ],
  "license": "MIT",
  "author": "code2nguyen@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/code2nguyen/web-components.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "wireit",
    "build:only": "vite build",
    "type-check": "wireit"
  },
  "wireit": {
    "type-check": {
      "dependencies": [
        "../../core:build"
      ],
      "command": "tsc -p tsconfig.lib.json --composite false"
    },
    "build": {
      "dependencies": [
        "type-check"
      ],
      "command": "vite build"
    }
  },
  "dependencies": {
    "@c2n/core": "*",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@c2n/config": "*"
  },
  "customElements": "custom-elements.json"
}
