---
import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
}
const { headings } = Astro.props
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
---

{
  items.length > 0 && (
    <nav class="toc" aria-label="On this page">
      <div class="toc__title">On this page</div>
      <ul>
        {items.map((heading) => (
          <li class={`toc__level-${heading.depth}`}>
            <a href={`#${heading.slug}`} data-slug={heading.slug}>
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style lang="scss">
  .toc {
    font-size: 13px;
    &__title {
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--site-color-on-surface-muted);
      margin-bottom: 8px;
    }
    ul {
      list-style: none;
      margin: 0;
      padding: 0;
      border-left: 1px solid var(--site-color-outline-variant);
    }
    a {
      display: block;
      padding: 4px 0 4px 12px;
      margin-left: -1px;
      border-left: 1px solid transparent;
      color: var(--site-color-on-surface-variant);
      &:hover {
        text-decoration: none;
        color: var(--site-color-on-surface);
      }
      &.active {
        color: var(--site-color-primary);
        border-left-color: var(--site-color-primary);
      }
    }
    &__level-3 a {
      padding-left: 24px;
      font-size: 12.5px;
    }
  }
</style>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a[data-slug]'))
  if (links.length > 0) {
    const headings = links.map((link) => document.getElementById(link.dataset.slug!)).filter((el): el is HTMLElement => !!el)
    const setActive = (id: string) => links.forEach((link) => link.classList.toggle('active', link.dataset.slug === id))

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
        if (visible[0]) setActive(visible[0].target.id)
      },
      { rootMargin: '-64px 0px -70% 0px', threshold: 0 },
    )
    headings.forEach((heading) => observer.observe(heading))
    if (headings[0]) setActive(headings[0].id)
  }
</script>
