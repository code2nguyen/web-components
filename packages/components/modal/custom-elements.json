{"schemaVersion":"1.0.0","readme":"","modules":[{"kind":"javascript-module","path":"src/modal.ts","declarations":[{"kind":"class","description":"Modal dialog built on the native `<dialog>` element: focus is trapped and restored, Escape closes, the page behind\nis inert and covered by a backdrop. Open it with the `open` attribute or `show()`, close it with `close(returnValue)`,\nthe built-in close button, a click on the backdrop or Escape (each can be turned off). Content is split into a\n`title` slot, the body (default slot) and a `footer` slot for actions; the body scrolls when the content is taller\nthan `--c2-modal--max-height`. While a modal is open the page does not scroll (`no-scroll-lock` opts out).","name":"Modal","cssProperties":[{"type":{"text":"pixel"},"name":"--c2-modal--width","default":"min(480px, calc(100vw - 32px))"},{"type":{"text":"pixel"},"name":"--c2-modal--max-height","default":"calc(100vh - 64px)"},{"type":{"text":"margin"},"description":"`auto` centres vertically; a length pins the dialog to the top.","name":"--c2-modal--margin-top","default":"auto"},{"type":{"text":"margin"},"name":"--c2-modal--margin-bottom","default":"auto"},{"type":{"text":"background"},"name":"--c2-modal--background","default":"#ffffff"},{"type":{"text":"color"},"name":"--c2-modal--color","default":"#18181b"},{"type":{"text":"border"},"name":"--c2-modal--border","default":"none"},{"type":{"text":"border-radius"},"name":"--c2-modal--border-top-left-radius","default":"14px"},{"type":{"text":"border-radius"},"name":"--c2-modal--border-top-right-radius","default":"14px"},{"type":{"text":"border-radius"},"name":"--c2-modal--border-bottom-left-radius","default":"14px"},{"type":{"text":"border-radius"},"name":"--c2-modal--border-bottom-right-radius","default":"14px"},{"type":{"text":"box-shadow"},"name":"--c2-modal--box-shadow","default":"0 24px 60px rgba(0, 0, 0, 0.25)"},{"type":{"text":"time"},"description":"Open/close animation; `0ms` disables it.","name":"--c2-modal--transition-duration","default":"200ms"},{"type":{"text":"transform"},"description":"Where the dialog animates from and to.","name":"--c2-modal--enter-transform","default":"translateY(12px) scale(0.98)"},{"type":{"text":"padding"},"name":"--c2-modal__header--padding-top","default":"20px"},{"type":{"text":"padding"},"name":"--c2-modal__header--padding-right","default":"20px"},{"type":{"text":"padding"},"name":"--c2-modal__header--padding-bottom","default":"0px"},{"type":{"text":"padding"},"name":"--c2-modal__header--padding-left","default":"24px"},{"type":{"text":"font-size"},"name":"--c2-modal__header--font-size","default":"17px"},{"type":{"text":"font-weight"},"name":"--c2-modal__header--font-weight","default":"600"},{"type":{"text":"line-height"},"name":"--c2-modal__header--line-height","default":"1.35"},{"type":{"text":"border"},"description":"Divider under the header; raise `header--padding-bottom` with it.","name":"--c2-modal__header--border-bottom"},{"type":{"text":"padding"},"name":"--c2-modal__body--padding-top","default":"12px"},{"type":{"text":"padding"},"name":"--c2-modal__body--padding-right","default":"24px"},{"type":{"text":"padding"},"name":"--c2-modal__body--padding-bottom","default":"20px"},{"type":{"text":"padding"},"name":"--c2-modal__body--padding-left","default":"24px"},{"type":{"text":"font-size"},"name":"--c2-modal__body--font-size","default":"14px"},{"type":{"text":"line-height"},"name":"--c2-modal__body--line-height","default":"1.6"},{"type":{"text":"color"},"description":"Defaults to the dialog colour.","name":"--c2-modal__body--color"},{"type":{"text":"padding"},"name":"--c2-modal__footer--padding-top","default":"0px"},{"type":{"text":"padding"},"name":"--c2-modal__footer--padding-right","default":"24px"},{"type":{"text":"padding"},"name":"--c2-modal__footer--padding-bottom","default":"20px"},{"type":{"text":"padding"},"name":"--c2-modal__footer--padding-left","default":"24px"},{"type":{"text":"pixel"},"name":"--c2-modal__footer--gap","default":"8px"},{"type":{"text":"justify-content"},"name":"--c2-modal__footer--justify-content","default":"flex-end"},{"type":{"text":"border"},"description":"Divider above the footer; raise `footer--padding-top` with it.","name":"--c2-modal__footer--border-top"},{"type":{"text":"pixel"},"name":"--c2-modal__close--size","default":"32px"},{"type":{"text":"pixel"},"name":"--c2-modal__close--icon-size","default":"18px"},{"type":{"text":"border-radius"},"name":"--c2-modal__close--border-radius","default":"8px"},{"type":{"text":"color"},"name":"--c2-modal__close--color","default":"#71717a"},{"type":{"text":"background"},"name":"--c2-modal__close__hover--background","default":"#f4f4f5"},{"type":{"text":"color"},"name":"--c2-modal__close__hover--color","default":"#18181b"},{"type":{"text":"outline"},"name":"--c2-modal__close__focus--outline","default":"2px solid rgba(2, 101, 220, 0.4)"},{"type":{"text":"background"},"name":"--c2-modal__backdrop--background","default":"rgba(9, 9, 11, 0.45)"},{"type":{"text":"backdrop-filter"},"description":"e.g. `blur(4px)`.","name":"--c2-modal__backdrop--backdrop-filter"}],"slots":[{"description":"Body content.","name":""},{"description":"Heading shown in the header; the dialog is labelled by it.","name":"title"},{"description":"Actions row (a flex row, see the `footer--*` tokens).","name":"footer"},{"description":"Replaces the default × icon of the close button.","name":"close-icon"}],"members":[{"kind":"field","name":"open","type":{"text":"boolean"},"default":"false","description":"Open state. Setting it shows or closes the dialog.","attribute":"open","reflects":true},{"kind":"field","name":"label","type":{"text":"string | undefined"},"default":"undefined","description":"Accessible name when there is no `title` slot.","attribute":"label"},{"kind":"field","name":"noBackdropClose","type":{"text":"boolean"},"default":"false","description":"Keep the dialog open when the backdrop is clicked.","attribute":"no-backdrop-close"},{"kind":"field","name":"noEs