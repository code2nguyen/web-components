{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "types": ["node", "vite/client"]
  },
  "include": ["../playwright.config.ts", "./**/*.ts", "../packages/components/*/test/**/*.ts", "../open-packages/*/test/**/*.ts"]
}
