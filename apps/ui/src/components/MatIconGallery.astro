---
import { materialIconNames } from '../data/material-icon-names'
import MdxCodeBlock from './MdxCodeBlock.astro'

const items = materialIconNames.map((name) => ({
  name,
  markup: `<c2-mat-icon>${name}</c2-mat-icon>`,
}))
const studioUid = 'mat-icon-gallery-studio'
const studioCode = '<c2-mat-icon>home</c2-mat-icon>'
---

<div class="mat-icon-gallery__toolbar">
  <input
    type="search"
    class="mat-icon-gallery__filter"
    placeholder={`Filter ${items.length.toLocaleString('en')} icons…`}
    aria-label="Filter icons"
    autocomplete="off"
  />
  <span class="mat-icon-gallery__count">{items.length.toLocaleString('en')} icons · select one to customize</span>
</div>
<div class="mat-icon-gallery">
  {
    items.map(({ name, markup }) => (
      <div class="mat-icon-gallery__item" data-name={name}>
        <button type="button" class="mat-icon-gallery__configure" title={`Customize ${name}`}>
          <Fragment set:html={markup} />
          <span class="mat-icon-gallery__label">{name}</span>
        </button>
        <c2-copy-button class="mat-icon-gallery__copy" pin value={markup} label={`Copy ${name} HTML`} />
      </div>
    ))
  }
  <p class="mat-icon-gallery__empty" hidden>No icon matches.</p>
</div>

<MdxCodeBlock code={studioCode} lang="html" uid={studioUid} style="" label="Selected icon" offscreen>
  <c2-mat-icon data-target-uid={studioUid}>home</c2-mat-icon>
</MdxCodeBlock>

<script>
  import { openIconInStudio } from '../utils/playground.ts'

  import '@c2n/copy-button'
  import '@c2n/mat-icon'
</script>

<style lang="scss">
  .mat-icon-gallery__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin: 16px 0 12px;
  }
  .mat-icon-gallery__filter {
    flex: 1;
    min-width: 200px;
    max-width: 360px;
    height: 36px;
    padding: 0 12px;
    font: inherit;
    font-size: 14px;
    color: var(--site-color-on-surface);
    background: var(--site-color-surface-container-1);
    border: 1px solid var(--site-color-outline-variant);
    border-radius: var(--site-radius-sm);
    &:focus {
      outline: none;
      border-color: var(--site-color-primary);
    }
  }
  .mat-icon-gallery__count {
    font-size: 12.5px;
    color: var(--site-color-on-surface-muted);
  }
  .mat-icon-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(104px, 1fr));
    gap: 8px;
    margin: 0 0 16px;
    --c2-mat-icon--font-size: 24px;
  }
  .mat-icon-gallery__item {
    position: relative;
    min-width: 0;
    border: 1px solid var(--site-color-outline-variant);
    border-radius: var(--site-radius-md);
    transition:
      border-color 150ms var(--site-ease),
      background-color 150ms var(--site-ease);
    &:hover,
    &:focus-within {
      border-color: var(--site-color-outline);
      background: var(--site-color-surface-container-1);
    }
    &[hidden] {
      display: none;
    }
  }
  .mat-icon-gallery__configure {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 14px 6px 10px;
    border: 0;
    background: transparent;
    color: var(--site-color-on-surface);
    cursor: pointer;
  }
  .mat-icon-gallery__copy {
    z-index: 1;
    --c2-copy-button__pin--offset-x: 5px;
    --c2-copy-button__pin--offset-y: 5px;
    --c2-copy-button__container--height: 26px;
    --c2-copy-button__container--min-width: 26px;
    --c2-copy-button__container--padding-left: 5px;
    --c2-copy-button__container--padding-right: 5px;
    --c2-copy-button__container--background-color: var(--site-color-surface);
    --c2-copy-button__container--border: 1px solid var(--site-color-outline-variant);
    --c2-copy-button__container__hover--background-color: var(--site-color-surface-container-2);
    --c2-copy-button__icon--size: 14px;
  }
  .mat-icon-gallery__label {
    max-width: 100%;
    overflow: hidden;
    font-size: 11px;
    line-height: 1.2;
    color: var(--site-color-on-surface-variant);
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .mat-icon-gallery__empty {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--site-color-on-surface-muted);
    &[hidden] {
      display: none;
    }
  }
</style>

<script>
  const filter = document.querySelector<HTMLInputElement>('.mat-icon-gallery__filter')
  const items = Array.from(document.querySelectorAll<HTMLElement>('.mat-icon-gallery__item'))
  const empty = document.querySelector<HTMLElement>('.mat-icon-gallery__empty')

  filter?.addEventListener('input', () => {
    const query = filter.value
      .trim()
      .toLowerCase()
      .replace(/[\s-]+/g, '_')
    let visible = 0
    items.forEach((item) => {
      const match = !query || (item.dataset.name ?? '').includes(query)
      item.hidden = !match
      if (match) visible++
    })
    if (empty) empty.hidden = visible > 0
  })

  items.forEach((item) => {
    item.querySelector('.mat-icon-gallery__configure')?.addEventListener('click', () => {
      openIconInStudio({ uid: 'mat-icon-gallery-studio', tagName: 'c2-mat-icon', textContent: item.dataset.name ?? '' })
    })
  })
</script>
