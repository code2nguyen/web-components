    },
    "./chart-data.js": {
      "types": "./types/src/chart-data.d.ts",
      "default": "./dist/chart-data.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.js"
    },
    "./custom-elements.json": "./custom-elements.json"
