{
  "name": "@c2n/example-support-inbox-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "wireit",
    "test:browser": "playwright test --config playwright.config.ts",
    "type-check": "wireit"
  },
  "wireit": {
    "type-check": {
      "dependencies": [
        "../../../packages/core:build",
        "../../../packages/umbrella:build",
        "../../../packages/icons/feather-icons:build"
      ],
      "command": "vue-tsc -p tsconfig.lib.json --composite false"
    },
    "build": {
      "dependencies": [
        "type-check"
      ],
      "files": [
        "src/**",
        "index.html",
        "vite.config.ts",
        "tsconfig*.json"
      ],
      "output": [
        "dist/**"
      ],
      "command": "vite build"
    }
  },
  "dependencies": {
    "@c2n/components": "*",
    "@c2n/feather-icons": "*",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@c2n/config": "*",
    "@c2n/framework-types": "*",
    "@vitejs/plugin-vue": "6.0.8",
    "vue-tsc": "3.3.11"
  }
}
