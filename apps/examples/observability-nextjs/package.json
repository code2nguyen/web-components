{
  "name": "@c2n/example-observability-nextjs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "wireit",
    "type-check": "wireit",
    "test:unit": "node --test test/unit/*.test.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:a11y": "playwright test test/accessibility.spec.ts --project=chromium",
    "preview": "node test/serve-static.mjs"
  },
  "wireit": {
    "type-check": {
      "dependencies": [
        "../../../packages/core:build",
        "../../../packages/tools/theme:build",
        "../../../packages/components/badge:build",
        "../../../packages/components/breadcrumb:build",
        "../../../packages/components/button:build",
        "../../../packages/components/button-group:build",
        "../../../packages/components/card:build",
        "../../../packages/components/chart:build",
        "../../../packages/components/checkbox:build",
        "../../../packages/components/dashboard:build",
        "../../../packages/components/date-input:build",
        "../../../packages/components/date-selector:build",
        "../../../packages/components/details:build",
        "../../../packages/components/header:build",
        "../../../packages/components/icon-button:build",
        "../../../packages/components/link-button:build",
        "../../../packages/components/list-item:build",
        "../../../packages/components/menu:build",
        "../../../packages/components/modal:build",
        "../../../packages/components/number-input:build",
        "../../../packages/components/pagination:build",
        "../../../packages/components/progress:build",
        "../../../packages/components/radio:build",
        "../../../packages/components/select:build",
        "../../../packages/components/sheet:build",
        "../../../packages/components/side-nav:build",
        "../../../packages/components/skeleton:build",
        "../../../packages/components/spinner:build",
        "../../../packages/components/stat:build",
        "../../../packages/components/status-panel:build",
        "../../../packages/components/steps:build",
        "../../../packages/components/switch:build",
        "../../../packages/components/table:build",
        "../../../packages/components/tabs:build",
        "../../../packages/components/text-field:build",
        "../../../packages/components/theme-select:build",
        "../../../packages/components/toast:build",
        "../../../packages/components/tooltip:build",
        "../../../packages/components/tree:build",
        "../../../packages/icons/feather-icons:build"
      ],
      "command": "tsc --noEmit"
    },
    "build": {
      "dependencies": [
        "type-check"
      ],
      "files": [
        "app/**",
        "components/**",
        "features/**",
        "lib/**",
        "providers/**",
        "public/**",
        "types/**",
        "app.config.json",
        "next.config.ts",
        "next-env.d.ts",
        "package.json",
        "tsconfig.json"
      ],
      "output": [
        "out/**"
      ],
      "command": "next build"
    }
  },
  "dependencies": {
    "@c2n/badge": "*",
    "@c2n/breadcrumb": "*",
    "@c2n/button": "*",
    "@c2n/button-group": "*",
    "@c2n/card": "*",
    "@c2n/chart": "*",
    "@c2n/checkbox": "*",
    "@c2n/core": "*",
    "@c2n/dashboard": "*",
    "@c2n/date-input": "*",
    "@c2n/date-selector": "*",
    "@c2n/details": "*",
    "@c2n/feather-icons": "*",
    "@c2n/header": "*",
    "@c2n/icon-button": "*",
    "@c2n/link-button": "*",
    "@c2n/list-item": "*",
    "@c2n/menu": "*",
    "@c2n/modal": "*",
    "@c2n/number-input": "*",
    "@c2n/pagination": "*",
    "@c2n/progress": "*",
    "@c2n/radio": "*",
    "@c2n/select": "*",
    "@c2n/sheet": "*",
    "@c2n/side-nav": "*",
    "@c2n/skeleton": "*",
    "@c2n/spinner": "*",
    "@c2n/stat": "*",
    "@c2n/status-panel": "*",
    "@c2n/steps": "*",
    "@c2n/switch": "*",
    "@c2n/table": "*",
    "@c2n/tabs": "*",
    "@c2n/text-field": "*",
    "@c2n/theme": "*",
    "@c2n/theme-select": "*",
    "@c2n/toast": "*",
    "@c2n/tooltip": "*",
    "@c2n/tree": "*",
    "next": "16.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@c2n/config": "*",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
