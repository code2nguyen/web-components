on":"Shown in the summary once every hunk is decided, after Start over: the app's Apply button.","name":"actions"}],"members":[{"kind":"field","name":"original","type":{"text":"string"},"default":"''","description":"The text before the edit.","attribute":"original"},{"kind":"field","name":"modified","type":{"text":"string"},"default":"''","description":"The text after the edit.","attribute":"modified"},{"kind":"field","name":"label","type":{"text":"string"},"default":"''","description":"Names the review; shown in the header.","attribute":"label"},{"kind":"field","name":"fileName","type":{"text":"string"},"default":"''","description":"The file the edit is for, shown in the header after the label.","attribute":"file-name"},{"kind":"field","name":"context","type":{"text":"number"},"default":"3","description":"Unchanged lines shown on each side of a hunk.","attribute":"context"},{"kind":"field","name":"undecided","type":{"text":"ChangeReviewUndecided"},"default":"'original'","description":"Which side an open hunk keeps in `result`: `original` (as if rejected, the default) or `modified`.","attribute":"undecided"},{"kind":"field","name":"decisions","type":{"text":"ReviewDecision[]"},"default":"[]","description":"One decision per hunk: `'accepted'`, `'rejected'` or `null` while open. Set it to restore a review."},{"kind":"field","name":"current","type":{"text":"number"},"privacy":"private","default":"0","description":"The hunk the bar points at and the keyboard acts on."},{"kind":"field","name":"announcement","type":{"text":"string"},"privacy":"private","default":"''"},{"kind":"field","name":"review","type":{"text":"Review"},"privacy":"private","default":"{ hunks: [], rows: [], lines: [] }"},{"kind":"field","name":"internals","privacy":"private","readonly":true},{"kind":"field","name":"msg","privacy":"private","readonly":true,"default":"new LocalizeController(this, changeReviewMessages)"},{"kind":"field","name":"hunks","type":{"text":"readonly ReviewHunk[]"},"description":"The hunks of the current texts.","readonly":true},{"kind":"field","name":"result","type":{"text":"string"},"description":"The text the decisions produce; an open hunk keeps its `undecided` side.","readonly":true},{"kind":"method","name":"accept","return":{"type":{"text":"void"}},"parameters":[{"name":"index","default":"this.current"}],"description":"Accepts a hunk (the current one by default)."},{"kind":"method","name":"reject","return":{"type":{"text":"void"}},"parameters":[{"name":"index","default":"this.current"}],"description":"Rejects a hunk (the current one by default)."},{"kind":"method","name":"undo","return":{"type":{"text":"void"}},"parameters":[{"name":"index","type":{"text":"number"}}],"description":"Opens a decided hunk again."},{"kind":"method","name":"acceptAll","return":{"type":{"text":"void"}},"description":"Accepts every hunk still open."},{"kind":"method","name":"rejectAll","return":{"type":{"text":"void"}},"description":"Rejects every hunk still open."},{"kind":"method","name":"reset","return":{"type":{"text":"void"}},"description":"Opens every hunk again."},{"kind":"method","name":"goTo","return":{"type":{"text":"void"}},"parameters":[{"name":"index","type":{"text":"number"}}],"description":"Moves to a hunk and focuses it."},{"kind":"field","name":"open","type":{"text":"number"},"privacy":"private","readonly":true},{"kind":"method","name":"counts","privacy":"private"},{"kind":"method","name":"decide","privacy":"private","return":{"type":{"text":"void"}},"parameters":[{"name":"index","type":{"text":"number"}},{"name":"decision","type":{"text":"'accepted' | 'rejected'"}}]},{"kind":"method","name":"decideOpen","privacy":"private","return":{"type":{"text":"void"}},"parameters":[{"name":"decision","type":{"text":"'accepted' | 'rejected'"}}]},{"kind":"method","name":"nextOpen","privacy":"private","return":{"type":{"text":"number"}},"parameters":[{"name":"from","type":{"text":"number"}}]},{"kind":"method","name":"setDecisions","privacy":"private","ret