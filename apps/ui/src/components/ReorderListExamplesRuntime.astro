---
/** Enhances reorder list examples whose property-only API (`renderRank`) or form behaviour cannot be expressed as HTML. */
---

<script>
  import { html } from 'lit'
  import type { ReorderList } from '@c2n/components/reorder-list'
  import '@c2n/components/reorder-list'
  import { addTranslations } from '@c2n/core/localize.js'
  import '@c2n/components/button'

  // The French an app would add for the gallery's French card: the library ships English only.
  addTranslations({
    fr: {
      'reorder-list': {
        instructions: 'Appuyez sur Espace pour saisir un élément. Déplacez-le avec les flèches, Début ou Fin ; Espace le dépose et Échap annule.',
        item: 'Élément',
        pickedUp: '{0} saisi, position {1} sur {2}. Déplacez-le avec les flèches, Début ou Fin ; Espace le dépose et Échap annule.',
        returned: '{0} revenu à la position {1}.',
        atFirst: '{0} est déjà à la première position permise.',
        atLast: '{0} est déjà à la dernière position permise.',
        moved: '{0} déplacé à la position {1} sur {2}.',
        dropped: '{0} déplacé de la position {1} à {2}.',
        movedOut: '{0} a quitté la liste.',
        canceled: "Réorganisation annulée. L'élément est revenu à sa position d'origine.",
        canceledNotEditable: "Réorganisation annulée : la modification n'est plus disponible.",
        canceledItemsChanged: 'Les éléments ont changé. Réorganisation annulée.',
        rank: { '1': '1er', other: '{0}e' },
      },
    },
  })

  const ordinals = new Intl.PluralRules('en', { type: 'ordinal' })
  const suffixes: Record<string, string> = { one: 'st', two: 'nd', few: 'rd', other: 'th' }

  function setupPodium(list: ReorderList) {
    list.renderRank = ({ rank }) => html`${rank}<sup>${suffixes[ordinals.select(rank)]}</sup>`
  }

  function setupForm(list: ReorderList) {
    const form = list.closest('form')
    const output = form?.querySelector('output')
    if (!form || !output) return
    const show = () => {
      output.value = new FormData(form).getAll(list.name).join(' › ')
    }
    void list.updateComplete.then(show)
    list.addEventListener('input', show)
    form.addEventListener('submit', (event) => {
      event.preventDefault()
      show()
    })
    form.addEventListener('reset', () => requestAnimationFrame(show))
  }

  interface Task {
    id: string
    label: string
    /** The list the row came from, which `dragData` adds to what a row carries. */
    from?: string
  }

  /**
   * Lists that trade rows (`drag-kind` and `drop-kind`): the list a row lands on fires `item-drop` with the row to insert
   * before, and the page adds one; the list it left fires `item-move-out`, and the page removes the old one. The arrow
   * button is the keyboard path: `moveItemTo` on the list the row is in.
   */
  function setupTransfer(list: ReorderList) {
    // What a row carries: the default `{ id, label }`, plus the list it leaves.
    list.dragData = ({ key, element }) => ({ id: key, label: element.dataset.reorderLabel ?? '', from: list.getAttribute('aria-label') ?? '' })
    list.addEventListener('item-drop', ({ detail }) => {
      for (const task of detail.items as Task[]) list.insertBefore(rowFor(list, task), detail.before ?? null)
    })
    list.addEventListener('item-move-out', ({ detail }) => {
      for (const row of detail.rows) row.remove()
    })
    list.querySelectorAll<HTMLElement>(':scope > [data-reorder-key]').forEach((row) => wireMove(list, row))
  }

  /** A row as the page builds one, with its "move to the other list" button. */
  function rowFor(list: ReorderList, task: Task): HTMLElement {
    const row = document.createElement('div')
    row.dataset.reorderKey = task.id
    row.dataset.reorderLabel = task.label
    const label = document.createElement('span')
    label.textContent = task.label
    if (task.from) {
      const from = document.createElement('small')
      from.className = 'transfer-from'
      from.textContent = ` · from ${task.from}`
      label.append(from)
    }
    row.append(label)
    wireMove(list, row)
    return row
  }

  function otherList(list: ReorderList): ReorderList | undefined {
    // The card's container, not the parent: each list sits in its own island wrapper on the docs site.
    const lists = list.closest('.task-lists')?.querySelectorAll<ReorderList>('c2-reorder-list[data-reorder-list-example="transfer"]') ?? []
    return [...lists].find((candidate) => candidate !== list)
  }

  /** Adds the keyboard path to a row: a button that moves it to the other list, from whichever list it is in now. */
  function wireMove(list: ReorderList, row: HTMLElement) {
    row.querySelector('c2-button')?.remove()
    const target = otherList(list)
    const button = document.createElement('c2-button')
    button.className = 'transfer-move'
    button.textContent = '→'
    button.setAttribute('aria-label', `Move ${row.dataset.reorderLabel} to ${target?.getAttribute('aria-label') ?? 'the other list'}`)
    button.addEventListener('click', () => {
      const from = row.closest<ReorderList>('c2-reorder-list')
      const to = from && otherList(from)
      if (from && to && row.dataset.reorderKey) from.moveItemTo(to, row.dataset.reorderKey)
    })
    row.append(button)
  }

  const initialized = new WeakSet<ReorderList>()

  function setup() {
    document.querySelectorAll<ReorderList>('c2-reorder-list[data-reorder-list-example]').forEach((list) => {
      if (initialized.has(list)) return
      // A pair is wired once both lists are in the page: each is an island of its own, and the move buttons name the
      // other one.
      if (list.dataset.reorderListExample === 'transfer' && !otherList(list)) return
      initialized.add(list)
      if (list.dataset.reorderListExample === 'podium') setupPodium(list)
      if (list.dataset.reorderListExample === 'form') setupForm(list)
      if (list.dataset.reorderListExample === 'transfer') setupTransfer(list)
    })
  }

  setup()
  const observer = new MutationObserver(setup)
  observer.observe(document.documentElement, { childList: true, subtree: true })
  document.addEventListener('astro:page-load', setup)
</script>
