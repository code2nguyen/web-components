---
/** Enhances reorder list examples whose property-only API (`renderRank`) or form behaviour cannot be expressed as HTML. */
---

<script>
  import { html } from 'lit'
  import type { ReorderList } from '@c2n/components/reorder-list'
  import '@c2n/components/reorder-list'
  import { addTranslations } from '@c2n/core/localize.js'
  import { writeItemPayload } from '@c2n/core/controllers/drop-zone.js'

  // The French an app would add for the gallery's French card: the library ships English only.
  addTranslations({
    fr: {
      'reorder-list': {
        instructions: 'Appuyez sur Espace pour saisir un élément. Déplacez-le avec les flèches, Début ou Fin ; Espace le dépose et Échap annule.',
        item: 'Élément',
        pickedUp: '{0} saisi, position {1} sur {2}. Déplacez-le avec les flèches, Début ou Fin ; Espace le dépose et Échap annule.',
        returned: '{0} revenu à la position {1}.',
        atFirst: '{0} est déjà à la première position permise.',
        atLast: '{0} est déjà à la dernière position permise.',
        moved: '{0} déplacé à la position {1} sur {2}.',
        dropped: '{0} déplacé de la position {1} à {2}.',
        canceled: "Réorganisation annulée. L'élément est revenu à sa position d'origine.",
        canceledNotEditable: "Réorganisation annulée : la modification n'est plus disponible.",
        canceledItemsChanged: 'Les éléments ont changé. Réorganisation annulée.',
        rank: { '1': '1er', other: '{0}e' },
      },
    },
  })

  const ordinals = new Intl.PluralRules('en', { type: 'ordinal' })
  const suffixes: Record<string, string> = { one: 'st', two: 'nd', few: 'rd', other: 'th' }

  function setupPodium(list: ReorderList) {
    list.renderRank = ({ rank }) => html`${rank}<sup>${suffixes[ordinals.select(rank)]}</sup>`
  }

  function setupForm(list: ReorderList) {
    const form = list.closest('form')
    const output = form?.querySelector('output')
    if (!form || !output) return
    const show = () => {
      output.value = new FormData(form).getAll(list.name).join(' › ')
    }
    void list.updateComplete.then(show)
    list.addEventListener('input', show)
    form.addEventListener('submit', (event) => {
      event.preventDefault()
      show()
    })
    form.addEventListener('reset', () => requestAnimationFrame(show))
  }

  interface Task {
    id: string
    label: string
  }

  /** The row a handle is being dragged from, so the list it lands on can take it out of its old list. */
  let dragged: HTMLElement | null = null

  /** Wires a row's handle: a native drag that writes the row under the `task` kind, kept off the list's own reorder. */
  function wireHandle(row: HTMLElement) {
    const handle = row.querySelector<HTMLElement>('[data-drag-handle]')
    if (!handle || handle.dataset.wired) return
    handle.dataset.wired = ''
    handle.draggable = true
    // The list reorders on pointer events; the handle starts the browser's drag instead.
    handle.addEventListener('pointerdown', (event) => event.stopPropagation())
    handle.addEventListener('dragstart', (event) => {
      if (!event.dataTransfer) return
      const task: Task = { id: row.dataset.reorderKey ?? '', label: row.dataset.reorderLabel ?? row.textContent?.trim() ?? '' }
      writeItemPayload(event.dataTransfer, 'task', [task])
      event.dataTransfer.effectAllowed = 'move'
      dragged = row
    })
    handle.addEventListener('dragend', () => (dragged = null))
  }

  /** Lists that trade rows: the list fires `item-drop` with the row to insert before; the page adds the row. */
  function setupTransfer(list: ReorderList) {
    list.querySelectorAll<HTMLElement>(':scope > [data-reorder-key]').forEach(wireHandle)
    list.addEventListener('item-drop', ({ detail }) => {
      for (const task of detail.items as Task[]) {
        // Moved within the page: take the row out of its old list. Dropped from elsewhere: build a new one.
        const row = dragged?.dataset.reorderKey === task.id ? dragged : document.createElement('div')
        if (row !== dragged) {
          row.dataset.reorderKey = task.id
          row.dataset.reorderLabel = task.label
          const handle = document.createElement('span')
          handle.dataset.dragHandle = ''
          handle.setAttribute('aria-hidden', 'true')
          handle.textContent = '⠿'
          row.append(handle, ` ${task.label}`)
        }
        if (row === detail.before) continue
        list.insertBefore(row, detail.before ?? null)
        wireHandle(row)
      }
    })
  }

  const initialized = new WeakSet<ReorderList>()

  function setup() {
    document.querySelectorAll<ReorderList>('c2-reorder-list[data-reorder-list-example]').forEach((list) => {
      if (initialized.has(list)) return
      initialized.add(list)
      if (list.dataset.reorderListExample === 'podium') setupPodium(list)
      if (list.dataset.reorderListExample === 'form') setupForm(list)
      if (list.dataset.reorderListExample === 'transfer') setupTransfer(list)
    })
  }

  setup()
  const observer = new MutationObserver(setup)
  observer.observe(document.documentElement, { childList: true, subtree: true })
  document.addEventListener('astro:page-load', setup)
</script>
