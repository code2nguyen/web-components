{
  "name": "@c2n/button-group",
  "version": "0.0.6",
  "type": "module",
  "main": "dist/button-group.js",
  "exports": {
    ".": {
      "default": "./dist/button-group.js",
      "types": "./types/src/button-group.d.ts"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "dist",
    "types"
  ],
  "keywords": [
    "button group",
    "segmented control",
    "toggle group",
    "web component",
    "lit"
  ],
  "license": "MIT",
  "author": "code2nguyen@gmail.com",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/code2nguyen/web-components.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "wireit",
    "build:only": "vite build",
    "type-check": "wireit"
  },
  "wireit": {
    "type-check": {
      "dependencies": [
        "../../core:build",
        "../button:build"
      ],
      "command": "tsc -p tsconfig.lib.json --composite false"
    },
    "build": {
      "dependencies": [
        "type-check"
      ],
      "command": "vite build"
    }
  },
  "dependencies": {
    "@c2n/button": "0.0.6",
    "@c2n/core": "0.0.6",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@c2n/config": "*"
  },
  "customElements": "custom-elements.json"
}
