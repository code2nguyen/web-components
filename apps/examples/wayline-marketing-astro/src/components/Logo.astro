---
// The made-up product's mark: three stops joined by a line.
interface Props {
  size?: number
}

const { size = 24 } = Astro.props
---

<svg class="logo-mark" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path d="M4 18 C 9 18, 9 6, 14 6 S 20 12, 20 12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
  <circle cx="4" cy="18" r="2.6" fill="currentColor"></circle>
  <circle cx="14" cy="6" r="2.6" fill="currentColor"></circle>
  <circle cx="20" cy="12" r="2.6" fill="currentColor"></circle>
</svg>
