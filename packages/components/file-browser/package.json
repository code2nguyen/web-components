{
  "name": "@c2n/file-browser",
  "version": "1.0.21",
  "private": true,
  "type": "module",
  "main": "dist/file-browser.js",
  "exports": {
    ".": {
      "types": "./types/src/file-browser.d.ts",
      "default": "./dist/file-browser.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "dist",
    "types",
    "custom-elements.json",
    "react.d.ts",
    "react.js",
    "vue.d.ts",
    "vue.js"
  ],
  "keywords": [
    "file-browser",
    "web component",
    "lit"
  ],
  "license": "MIT",
  "author": "code2nguyen@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/code2nguyen/web-components.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "wireit",
    "build:only": "vite build",
    "type-check": "wireit"
  },
  "wireit": {
    "type-check": {
      "dependencies": [
        "../../core:build",
        "../breadcrumb:build",
        "../button:build",
        "../button-group:build",
        "../link-button:build",
        "../menu:build",
        "../search-field:build",
        "../skeleton:build",
        "../status-panel:build",
        "../tree:build"
      ],
      "command": "tsc -p tsconfig.lib.json --composite false"
    },
    "build": {
      "dependencies": [
        "type-check"
      ],
      "command": "vite build"
    }
  },
  "dependencies": {
    "@c2n/breadcrumb": "*",
    "@c2n/button": "*",
    "@c2n/button-group": "*",
    "@c2n/core": "*",
    "@c2n/link-button": "*",
    "@c2n/menu": "*",
    "@c2n/search-field": "*",
    "@c2n/skeleton": "*",
    "@c2n/status-panel": "*",
    "@c2n/tree": "*",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@c2n/config": "*"
  },
  "customElements": "custom-elements.json"
}
