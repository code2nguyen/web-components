{"schemaVersion":"1.0.0","readme":"","modules":[{"kind":"javascript-module","path":"src/time-input.ts","declarations":[{"kind":"class","description":"A form-associated time-of-day field backed by a native `<input type=\"time\">`. Values, `min` and `max` are 24-hour\nstrings (`HH:mm`, or `HH:mm:ss` when `step` is below 60 seconds); the browser displays them in the user's locale\n(12- or 24-hour), and keyboard editing stays native. The clock button (or Alt+ArrowDown in the field) opens the\ncomponent's own picker in a `c2-overlay` popover: a large readout of the chosen time over scroll-snapping hour,\nminute, second (when `step` is below 60) and AM/PM (on 12-hour locales) columns. The columns follow `step`, and\ntimes outside `min`/`max` are dimmed and cannot be picked.","name":"TimeInput","cssProperties":[{"type":{"text":"pixel"},"name":"--c2-time-input--min-height","default":"36px"},{"type":{"text":"pixel"},"name":"--c2-time-input--gap","default":"8px"},{"type":{"text":"padding"},"name":"--c2-time-input--padding","default":"6px 8px 6px 12px"},{"type":{"text":"border"},"name":"--c2-time-input--border","default":"1px solid #bcbcc6"},{"type":{"text":"border-radius"},"name":"--c2-time-input--border-radius","default":"6px"},{"type":{"text":"color"},"name":"--c2-time-input--color","default":"#18181b"},{"type":{"text":"color"},"name":"--c2-time-input--background","default":"#ffffff"},{"type":{"text":"font-size"},"name":"--c2-time-input--font-size","default":"14px"},{"type":{"text":"font-family"},"name":"--c2-time-input--font-family","default":"inherit"},{"type":{"text":"pixel"},"name":"--c2-time-input--line-height","default":"20px"},{"type":{"text":"border"},"name":"--c2-time-input__hover--border","default":"1px solid #a1a1aa"},{"type":{"text":"border"},"name":"--c2-time-input__focus--border","default":"1px solid #0265dc"},{"type":{"text":"outline"},"name":"--c2-time-input__focus--outline","default":"2px solid rgba(2, 101, 220, 0.4)"},{"type":{"text":"pixel"},"name":"--c2-