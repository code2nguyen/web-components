s closed; `detail.returnValue` is what `close()` received (`''` for Escape / backdrop / the × button).","name":"close"},{"type":{"text":"Event"},"description":"Native, cancelable: fired on Escape before closing.","name":"cancel"}],"attributes":[{"name":"open","type":{"text":"boolean"},"default":"false","description":"Open state. Setting it shows or closes the dialog.","fieldName":"open"},{"name":"label","type":{"text":"string | undefined"},"default":"undefined","description":"Accessible name when there is no `title` slot.","fieldName":"label"},{"name":"no-backdrop-close","type":{"text":"boolean"},"default":"false","description":"Keep the dialog open when the backdrop is clicked.","fieldName":"noBackdropClose"},{"name":"no-escape","type":{"text":"boolean"},"default":"false","description":"Ignore Escape.","fieldName":"noEscape"},{"name":"hide-close","type":{"text":"boolean"},"default":"false","description":"Hide the built-in × button.","fieldName":"hideClose"},{"name":"no-scroll-lock","type":{"text":"boolean"},"default":"false","description":"Leave the page scrollable while the dialog is open.","fieldName":"noScrollLock"}],"superclass":{"name":"LitElement","package":"lit"},"tagName":"c2-modal","customElement":true}],"exports":[{"kind":"js","name":"Modal","declaration":{"name":"Modal","module":"src/modal.ts"}},{"kind":"custom-element-definition","name":"c2-modal","declaration":{"name":"Modal","module":"src/modal.ts"}}]}]}