---
import { featherIconNames, featherIconTag } from '@c2n/feather-icons'
import MdxCodeBlock from './MdxCodeBlock.astro'

// Icons are emitted as plain markup (not SSR'd through the Lit renderer) to keep the page light;
// the client script below registers the elements so they render once the bundle loads.
const items = featherIconNames.map((name) => ({ name, markup: `<${featherIconTag(name)}></${featherIconTag(name)}>` }))
const studioUid = 'feather-icon-gallery-studio'
const studioTag = 'c2-feather-arrow-right'
const studioCode = `<${studioTag}></${studioTag}>`
---

<div class="feather-icon-gallery__toolbar">
  <input type="search" class="feather-icon-gallery__filter" placeholder={`Filter ${items.length} icons…`} aria-label="Filter icons" autocomplete="off" />
  <span class="feather-icon-gallery__count">{items.length} icons · select one to customize</span>
</div>
<div class="feather-icon-gallery">
  {
    items.map(({ name, markup }) => (
      <div class="feather-icon-gallery__item" data-name={name}>
        <button type="button" class="feather-icon-gallery__configure" title={`Customize ${name}`}>
          <Fragment set:html={markup} />
          <span class="feather-icon-gallery__label">{name}</span>
        </button>
        <c2-copy-button class="feather-icon-gallery__copy" pin value={markup} label={`Copy ${name} HTML`} />
      </div>
    ))
  }
  <p class="feather-icon-gallery__empty" hidden>No icon matches.</p>
</div>

<MdxCodeBlock code={studioCode} lang="html" uid={studioUid} style="" label="Selected icon" offscreen>
  <Fragment set:html={`<${studioTag} data-target-uid="${studioUid}"></${studioTag}>`} />
</MdxCodeBlock>

<script>
  import { openIconInStudio } from '../utils/playground.ts'

  import '@c2n/copy-button'
  import '@c2n/feather-icons'
</script>

<style lang="scss">
  .feather-icon-gallery__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin: 16px 0 12px;
  }
  .feather-icon-gallery__filter {
    flex: 1;
    min-width: 200px;
    max-width: 360px;
    height: 36px;
    padding: 0 12px;
    font: inherit;
    font-size: 14px;
    color: var(--site-color-on-surface);
    background: var(--site-color-surface-container-1);
    border: 1px solid var(--site-color-outline-variant);
    border-radius: var(--site-radius-sm);
    &:focus {
      outline: none;
      border-color: var(--site-color-primary);
    }
  }
  .feather-icon-gallery__count {
    font-size: 12.5px;
    color: var(--site-color-on-surface-muted);
  }
  .feather-icon-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(104px, 1fr));
    gap: 8px;
    margin: 0 0 16px;
    --c2-feather-icon--size: 22px;
  }
  .feather-icon-gallery__item {
    position: relative;
    min-width: 0;
    border: 1px solid var(--site-color-outline-variant);
    border-radius: var(--site-radius-md);
    transition:
      border-color 150ms var(--site-ease),
      background-color 150ms var(--site-ease);
    &:hover,
    &:focus-within {
      border-color: var(--site-color-outline);
      background: var(--site-color-surface-container-1);
    }
    &[hidden] {
      display: none;
    }
  }
  .feather-icon-gallery__configure {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 14px 6px 10px;
    border: 0;
    background: transparent;
    color: var(--site-color-on-surface);
    cursor: pointer;
  }
  .feather-icon-gallery__copy {
    z-index: 1;
    --c2-copy-button__pin--offset-x: 5px;
    --c2-copy-button__pin--offset-y: 5px;
    --c2-copy-button__container--height: 26px;
    --c2-copy-button__container--min-width: 26px;
    --c2-copy-button__container--padding-left: 5px;
    --c2-copy-button__container--padding-right: 5px;
    --c2-copy-button__container--background-color: var(--site-color-surface);
    --c2-copy-button__container--border: 1px solid var(--site-color-outline-variant);
    --c2-copy-button__container__hover--background-color: var(--site-color-surface-container-2);
    --c2-copy-button__icon--size: 14px;
  }
  .feather-icon-gallery__label {
    font-size: 11px;
    line-height: 1.2;
    color: var(--site-color-on-surface-variant);
    text-align: center;
    word-break: break-all;
  }
  .feather-icon-gallery__empty {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--site-color-on-surface-muted);
    &[hidden] {
      display: none;
    }
  }
</style>

<script>
  const filter = document.querySelector<HTMLInputElement>('.feather-icon-gallery__filter')
  const items = Array.from(document.querySelectorAll<HTMLElement>('.feather-icon-gallery__item'))
  const empty = document.querySelector<HTMLElement>('.feather-icon-gallery__empty')

  filter?.addEventListener('input', () => {
    const query = filter.value.trim().toLowerCase()
    let visible = 0
    items.forEach((item) => {
      const match = !query || (item.dataset.name ?? '').includes(query)
      item.hidden = !match
      if (match) visible++
    })
    if (empty) empty.hidden = visible > 0
  })

  items.forEach((item) => {
    item.querySelector('.feather-icon-gallery__configure')?.addEventListener('click', () => {
      const name = item.dataset.name ?? ''
      openIconInStudio({ uid: 'feather-icon-gallery-studio', tagName: `c2-feather-${name}` })
    })
  })
</script>
