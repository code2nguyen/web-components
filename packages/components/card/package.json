{
  "name": "@c2n/card",
  "version": "0.0.8",
  "type": "module",
  "main": "dist/card.js",
  "exports": {
    ".": {
      "types": "./types/src/card.d.ts",
      "default": "./dist/card.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "dist",
    "types",
    "react.d.ts",
    "react.js",
    "vue.d.ts",
    "vue.js"
  ],
  "keywords": [
    "card",
    "web component",
    "lit"
  ],
  "author": "code2nguyen@gmail.com",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/code2nguyen/web-components.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "wireit",
    "type-check": "wireit"
  },
  "wireit": {
    "type-check": {
      "dependencies": [
        "../../core:build"
      ],
      "command": "tsc -p tsconfig.lib.json --composite false"
    },
    "build": {
      "dependencies": [
        "type-check"
      ],
      "command": "vite build"
    }
  },
  "dependencies": {
    "@c2n/core": "0.0.8",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@c2n/config": "*"
  },
  "customElements": "custom-elements.json"
}
