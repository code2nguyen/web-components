---
/**
 * Wires the password-field examples that need script: a button marked `data-password-field-example="generate"` fills
 * the field it names (`data-for`, an id) with `generate()`, which draws a suggestion without opening the generator.
 * It also registers the French of the "In French" generator card.
 */
---

<script>
  import type { PasswordField } from '@c2n/components/password-field'
  import '@c2n/components/password-field'
  import { addTranslations } from '@c2n/core/localize.js'

  // The French of the "In French" card: the library ships its text in English only.
  addTranslations({
    fr: {
      'password-field': {
        generate: 'Générer un mot de passe',
        suggestion: 'Mot de passe suggéré',
        regenerate: 'En générer un autre',
        copy: 'Copier le mot de passe',
        use: 'Utiliser ce mot de passe',
        kind: 'Type de mot de passe',
        password: 'Mot de passe',
        passphrase: 'Phrase de passe',
        length: 'Longueur',
        lowercase: 'Minuscules (a–z)',
        uppercase: 'Majuscules (A–Z)',
        numbers: 'Chiffres (0–9)',
        symbols: 'Symboles (!@#)',
        words: 'Mots',
        separator: 'Séparateur',
        capitalize: 'Majuscule à chaque mot',
        includeNumber: 'Ajouter un chiffre',
        strength: 'Robustesse de la suggestion',
        entropy: 'environ {0} bits',
        noSuggestion: 'Aucune suggestion ne respecte les règles de ce champ.',
      },
    },
  })

  // A button that fills a field with `generate()`: the app's own "Suggest" action.
  document.addEventListener('click', async (event) => {
    const button = (event.target as Element | null)?.closest<HTMLElement>('[data-password-field-example="generate"]')
    const field = button?.dataset.for ? (button.getRootNode() as Document | ShadowRoot).querySelector<PasswordField>(`#${CSS.escape(button.dataset.for)}`) : null
    if (!field) return
    field.value = await field.generate({ kind: 'passphrase', words: 4, capitalize: true })
    field.revealed = true
  })
</script>
