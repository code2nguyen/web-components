{
  "name": "@c2n/navigation-menu",
  "version": "0.0.13",
  "type": "module",
  "main": "dist/navigation-menu.js",
  "exports": {
    ".": {
      "types": "./types/src/navigation-menu.d.ts",
      "default": "./dist/navigation-menu.js"
    },
    "./navigation-menu-item.js": {
      "types": "./types/src/navigation-menu-item.d.ts",
      "default": "./dist/navigation-menu-item.js"
    },
    "./navigation-menu-link.js": {
      "types": "./types/src/navigation-menu-link.d.ts",
      "default": "./dist/navigation-menu-link.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "dist",
    "types",
    "custom-elements.json",
    "react.d.ts",
    "react.js",
    "vue.d.ts",
    "vue.js"
  ],
  "keywords": [
    "navigation menu",
    "navbar",
    "mega menu",
    "web component",
    "lit"
  ],
  "license": "MIT",
  "author": "code2nguyen@gmail.com",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/code2nguyen/web-components.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "wireit",
    "build:only": "vite build",
    "type-check": "wireit"
  },
  "wireit": {
    "type-check": {
      "dependencies": [
        "../../core:build",
        "../overlay:build"
      ],
      "command": "tsc -p tsconfig.lib.json --composite false"
    },
    "build": {
      "dependencies": [
        "type-check"
      ],
      "command": "vite build"
    }
  },
  "dependencies": {
    "@c2n/core": "0.0.13",
    "@c2n/overlay": "0.0.13",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@c2n/config": "*"
  },
  "customElements": "custom-elements.json"
}
