{
  "name": "@c2n/barcode-scanner",
  "version": "1.0.25",
  "private": true,
  "type": "module",
  "main": "dist/barcode-scanner.js",
  "exports": {
    ".": {
      "types": "./types/src/barcode-scanner.d.ts",
      "default": "./dist/barcode-scanner.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./vue.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "dist",
    "types",
    "custom-elements.json",
    "react.d.ts",
    "react.js",
    "vue.d.ts",
    "vue.js"
  ],
  "keywords": [
    "barcode-scanner",
    "barcode",
    "qr code",
    "scanner",
    "web component",
    "lit"
  ],
  "license": "MIT",
  "author": "code2nguyen@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/code2nguyen/web-components.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "wireit",
    "build:only": "vite build",
    "type-check": "wireit"
  },
  "wireit": {
    "type-check": {
      "dependencies": [
        "../../core:build",
        "../camera-capture:build"
      ],
      "command": "tsc -p tsconfig.lib.json --composite false"
    },
    "build": {
      "dependencies": [
        "type-check"
      ],
      "command": "vite build"
    }
  },
  "dependencies": {
    "@c2n/camera-capture": "*",
    "@c2n/core": "*",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@c2n/config": "*",
    "@zxing/library": "^0.23.0"
  },
  "customElements": "custom-elements.json",
  "peerDependencies": {
    "@zxing/library": "^0.23.0"
  },
  "peerDependenciesMeta": {
    "@zxing/library": {
      "optional": true
    }
  }
}
