---
import type { MarkdownHeading } from 'astro'
import { rawElement } from '../utils/raw-element'

interface Props {
  headings: MarkdownHeading[]
}
const { headings } = Astro.props
const items = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((heading) => ({ id: heading.slug, label: heading.text, level: heading.depth }))

// Raw markup rather than JSX: `@astrojs/lit` would server-render the tag with `items` and `offset` set as properties
// behind `defer-hydration`, which nothing removes outside an island (see utils/raw-element.ts). chrome-modules.ts
// upgrades the plain tag. The headings are known at build time, so they are handed over as `items` rather than read
// from the page; `offset` is the sticky header plus the headings' scroll-margin-top.
const tocHtml = items.length > 0 ? rawElement('c2-table-of-contents', { class: 'toc', items, offset: 80 }) : ''
---

<div class="toc-wrapper"><Fragment set:html={tocHtml} /></div>

<style lang="scss">
  // The list is raw markup (set:html), which scoped styles do not reach without :global().
  .toc-wrapper :global(.toc) {
    --c2-table-of-contents--font-size: 13px;
    --c2-table-of-contents__title--font-size: 11.5px;
    --c2-table-of-contents__title--color: var(--site-color-on-surface-muted);
    --c2-table-of-contents__link--color: var(--site-color-on-surface-variant);
    --c2-table-of-contents__link__passed--color: var(--site-color-on-surface-variant);
    --c2-table-of-contents__link__hover--color: var(--site-color-on-surface);
    --c2-table-of-contents__link__active--color: var(--site-color-primary);
    --c2-table-of-contents__nested--font-size: 12.5px;
    --c2-table-of-contents__track--background-color: var(--site-color-outline-variant);
    --c2-table-of-contents__indicator--background-color: var(--site-color-primary);
  }
</style>
