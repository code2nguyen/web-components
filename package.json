{
  "name": "@c2n/web-components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/run-changed-component-tests.mjs --project=chromium",
    "test:changed": "node scripts/run-changed-component-tests.mjs",
    "test:changed:unit": "node --test scripts/*.test.mjs apps/ui/src/utils/*.test.ts",
    "test:button": "playwright test packages/components/button/test --project=chromium",
    "test:all": "playwright test",
    "test:serve": "vite --config tests/vite.config.ts",
    "test:type-check": "tsc -p tests/tsconfig.json",
    "test:report": "playwright show-report",
    "bench:table": "C2_BENCH=1 playwright test packages/components/table/test/table.bench.spec.ts --project=chromium --workers=1",
    "bench:table:baseline": "C2_BENCH_UPDATE=1 C2_BENCH=1 playwright test packages/components/table/test/table.bench.spec.ts --project=chromium --workers=1",
    "prepare": "husky",
    "lint": "wireit",
    "lint:check": "wireit",
    "lint:fix": "eslint . --fix",
    "fix": "npm run lint:fix && npm run format:fix",
    "format": "npm run format:fix",
    "version": "node packages/tools/mcp/scripts/stamp-version.ts && node packages/tools/skill/scripts/build-skill.ts && git add packages/tools/skill/skills packages/tools/skill/.claude-plugin packages/tools/skill/.mcp.json packages/tools/skill/plugin.json packages/tools/skill/mcp.json",
    "format:check": "prettier \"**/*.{cjs,html,js,json,md,ts,tsx,vue}\" --check",
    "format:fix": "prettier \"**/*.{cjs,html,js,json,md,ts,tsx,vue}\" --write",
    "ui": "npm run start -w apps/ui --",
    "ui:dev": "npm run dev -w apps/ui --",
    "ui:build": "wireit",
    "examples:build": "wireit",
    "build": "wireit",
    "build:generator": "npm run build --workspace=scripts/generator",
    "pregenerate": "npm run build:generator",
    "generate": "npm run plop --workspace=scripts/generator",
    "generate:example": "npm run build:generator && npm run plop --workspace=scripts/generator -- example",
    "clean": "npx del-cli **/node_modules **/dist **/types **/custom-elements.json package-lock.json -f",
    "build:tools": "wireit",
    "mcp:inspect": "npm run inspect -w packages/tools/mcp",
    "mcp:smoke": "npm run smoke -w packages/tools/mcp",
    "docs:check": "node scripts/check-component-docs.mjs",
    "check:lifecycle": "node scripts/check-component-lifecycle.mjs",
    "check:dogfood": "node scripts/check-dogfooding.mjs",
    "check:css-contracts": "node scripts/check-css-contracts.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "ajv": "^8.20.0",
    "husky": "9.1.7",
    "lerna": "10.0.1",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "semver": "7.7.2",
    "wireit": "^0.14.13"
  },
  "workspaces": [
    "open-packages/*",
    "packages/adapters/*",
    "packages/components/*",
    "packages/icons/*",
    "packages/core",
    "packages/tools/*",
    "apps/ui",
    "apps/examples/*",
    "scripts/generator"
  ],
  "overrides": {
    "@lit-labs/ssr": "3.2.2"
  },
  "wireit": {
    "lint": {
      "dependencies": [
        "lint:check"
      ]
    },
    "lint:check": {
      "files": [
        "**/*.{js,mjs,cjs,ts}",
        "eslint.config.js",
        "packages/tools/config/eslint.config.js",
        "!**/dist/**/*",
        "!**/types/**/*",
        "!node_modules/"
      ],
      "output": [],
      "command": "eslint ."
    },
    "build": {
      "dependencies": [
        "./packages/components/dashboard:build",
        "./packages/components/steps:build",
        "./packages/components/code-editor:build",
        "./packages/components/theme-select:build",
        "./packages/components/tree:build",
        "./packages/components/border-beam:build",
        "./packages/components/status-panel:build",
        "./packages/components/qr-code:build",
        "./packages/components/upload:build",
        "./packages/components/rate:build",
        "./packages/components/cascader:build",
        "./packages/components/questionnaire:build",
        "./packages/components/number-input:build",
        "./packages/components/date-input:build",
        "./packages/components/date-selector:build",
        "./packages/components/chart:build",
        "./packages/components/autocomplete:build",
        "./packages/components/header:build",
        "./packages/components/stat:build",
        "./packages/components/attachment:build",
        "./packages/components/virtual-list:build",
        "./packages/components/sheet:build",
        "./packages/components/skeleton:build",
        "./packages/components/progress:build",
        "./packages/components/pagination:build",
        "./packages/components/navigation-menu:build",
        "./packages/components/menu:build",
        "./packages/components/kbd:build",
        "./packages/components/table:build",
        "./packages/components/copy-button:build",
        "./packages/components/textarea:build",
        "./packages/components/switch:build",
        "./packages/components/spinner:build",
        "./packages/components/slider:build",
        "./packages/components/seperator:build",
        "./packages/components/breadcrumb:build",
        "./packages/components/badge:build",
        "./packages/components/toast:build",
        "./packages/components/radio:build",
        "./packages/components/button-group:build",
        "./packages/components/accordion:build",
        "./packages/components/modal:build",
        "./packages/components/button:build",
        "./packages/icons/feather-icons:build",
        "./packages/icons/phosphor-icons:build",
        "./open-packages/chatbot:build",
        "./packages/components/chat-input:build",
        "./packages/components/chat-message:build",
        "./packages/components/avatar:build",
        "./packages/components/side-nav:build",
        "./packages/components/card:build",
        "./packages/components/checkbox:build",
        "./packages/components/code-viewer:build",
        "./packages/components/color-area:build",
        "./packages/components/color-select:build",
        "./packages/components/color-slider:build",
        "./packages/components/details:build",
        "./packages/components/icon-button:build",
        "./packages/components/label:build",
        "./packages/components/list:build",
        "./packages/components/list-item:build",
        "./packages/components/mat-icon:build",
        "./packages/components/overlay:build",
        "./packages/components/reorder-list:build",
        "./packages/components/select:build",
        "./packages/components/tabs:build",
        "./packages/components/link-button:build",
        "./packages/components/text-field:build",
        "./packages/components/tooltip:build",
        "./packages/adapters/angular:build",
        "./packages/core:build",
        "./packages/tools/theme:build"
      ]
    },
    "examples:build": {
      "dependencies": [
        "./apps/examples/basic-form-html:build",
        "./apps/examples/data-platform-html:build",
        "./apps/examples/trading-dashboard-react:build",
        "./apps/examples/observability-nextjs:build",
        "./apps/examples/orders-admin-angular:build",
        "./apps/examples/support-inbox-vue:build"
      ]
    },
    "ui:build": {
      "dependencies": [
        "build",
        "examples:build"
      ],
      "command": "npm run build -w apps/ui"
    },
    "build:tools": {
      "dependencies": [
        "./packages/tools/framework-types:build",
        "./packages/tools/mcp:build",
        "./packages/tools/skill:build"
      ]
    }
  },
  "lint-staged": {
    "**/*.{cjs,html,js,json,md,ts,tsx,vue}": "prettier --write",
    "{*.{js,ts,tsx},!(dist)/**/*.{js,ts,tsx}}": "eslint --fix"
  },
  "optionalDependencies": {
    "@astrojs/compiler-binding-linux-x64-gnu": "0.4.0",
    "@bruits/satteri-linux-x64-gnu": "0.10.5",
    "@esbuild/linux-x64": "0.28.2",
    "@img/sharp-libvips-linux-x64": "1.3.3",
    "@img/sharp-linux-x64": "0.35.4",
    "@parcel/watcher-linux-x64-glibc": "2.6.0",
    "@rolldown/binding-linux-x64-gnu": "1.2.7",
    "@xn-sakina/rml-linux-x64-gnu": "2.8.0",
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}
