---
import { ToastRegion } from '@c2n/toast'
import { Checkbox } from '@c2n/checkbox'
import '@c2n/label'
import SiteButton from './ui/SiteButton.astro'
import SiteSelect from './ui/SiteSelect.astro'

const enterOptions = [
  ['slide-up', 'Slide up (from below)'],
  ['slide-down', 'Slide down (from above)'],
  ['slide-right', 'Slide right (from left)'],
  ['slide-left', 'Slide left (from right)'],
  ['fade', 'Fade in'],
  ['scale', 'Scale in'],
  ['none', 'None'],
]
const exitOptions = [
  ['fade', 'Fade out'],
  ['slide-up', 'Slide up'],
  ['slide-down', 'Slide down'],
  ['slide-right', 'Slide right'],
  ['slide-left', 'Slide left'],
  ['scale', 'Scale out'],
  ['none', 'None'],
]
const speedOptions = [
  ['200', 'Quick · 200 ms'],
  ['400', 'Gentle · 400 ms'],
  ['700', 'Slow · 700 ms'],
]
---

<section class="toast-demo" data-toast-demo>
  <div class="controls motion-controls">
    <div class="field">
      <c2-label class="field__label" for="toast-enter">Entrance</c2-label>
      <SiteSelect id="toast-enter" size="sm" hydrate="defined" data-toast-enter value="slide-up">
        <Fragment set:html={enterOptions.map(([value, text]) => `<c2-list-item value="${value}">${text}</c2-list-item>`).join('')} />
      </SiteSelect>
    </div>
    <div class="field">
      <c2-label class="field__label" for="toast-exit">Exit</c2-label>
      <SiteSelect id="toast-exit" size="sm" hydrate="defined" data-toast-exit value="fade">
        <Fragment set:html={exitOptions.map(([value, text]) => `<c2-list-item value="${value}">${text}</c2-list-item>`).join('')} />
      </SiteSelect>
    </div>
    <div class="field">
      <c2-label class="field__label" for="toast-speed">Speed</c2-label>
      <SiteSelect id="toast-speed" size="sm" hydrate="defined" data-toast-speed value="400">
        <Fragment set:html={speedOptions.map(([value, text]) => `<c2-list-item value="${value}">${text}</c2-list-item>`).join('')} />
      </SiteSelect>
    </div>
  </div>
  <label class="progress-toggle">
    <Checkbox client:load class="site-checkbox" data-toast-progress checked />
    Show countdown bar
  </label>
  <div class="controls">
    <SiteButton variant="ghost" size="sm" data-toast-single>Show notification</SiteButton>
    <SiteButton variant="ghost" size="sm" data-toast-burst>Send 8 notifications</SiteButton>
    <SiteButton variant="ghost" size="sm" data-toast-persistent>Show persistent</SiteButton>
    <SiteButton variant="ghost" size="sm" data-toast-clear>Clear all</SiteButton>
  </div>
  <p>Three visible at a time. Hover or focus the stack to pause timers.</p>
  <ToastRegion client:load showProgress inline maxVisible={3} label="Demo notifications" />
</section>

<script>
  import type { ToastRegion, ToastAnimation } from '@c2n/toast'
  import type { Select } from '@c2n/select'
  import type { Checkbox } from '@c2n/checkbox'

  // Astro islands own the runtime import. A second script import can use a different HMR URL.
  await customElements.whenDefined('c2-toast-region')
  await customElements.whenDefined('c2-select')

  document.querySelectorAll<HTMLElement>('[data-toast-demo]').forEach((demo) => {
    const region = demo.querySelector<ToastRegion>('c2-toast-region')!
    // `selection-change` does not bubble, so each listener goes on its own select. `detail.value` is an array
    // (one entry unless `multiple`); `selectedValue` is the single-value view of the same thing.
    demo.querySelector<Select>('[data-toast-enter]')?.addEventListener('selection-change', (event) => {
      region.enterAnimation = event.detail.value[0] as ToastAnimation
    })
    demo.querySelector<Select>('[data-toast-exit]')?.addEventListener('selection-change', (event) => {
      region.exitAnimation = event.detail.value[0] as ToastAnimation
    })
    demo.querySelector<Select>('[data-toast-speed]')?.addEventListener('selection-change', (event) => {
      region.animationDuration = Number(event.detail.value[0])
    })
    demo.querySelector<Checkbox>('[data-toast-progress]')?.addEventListener('change', (event) => {
      region.showProgress = (event.target as Checkbox).checked
    })
    let count = 0
    const show = () => region.show({ heading: `Notification ${++count}`, message: 'A new update has arrived.', variant: 'info', duration: 5000 })
    demo.querySelector('[data-toast-single]')?.addEventListener('click', show)
    demo.querySelector('[data-toast-burst]')?.addEventListener('click', () => {
      for (let i = 0; i < 8; i++) show()
    })
    demo.querySelector('[data-toast-persistent]')?.addEventListener('click', () => {
      region.show({ heading: 'Connection lost', message: 'This notification stays until dismissed.', variant: 'warning', duration: 0 })
    })
    demo.querySelector('[data-toast-clear]')?.addEventListener('click', () => region.clear())
  })
</script>

<style lang="scss">
  .toast-demo {
    padding: 20px;
    border: 1px solid var(--site-color-outline-variant);
    border-radius: 12px;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    &__label {
      color: var(--site-color-on-surface-variant);
    }
  }
  .progress-toggle {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    margin: 16px 0 12px;
    font-size: 13px;
  }
  .motion-controls {
    margin-bottom: 16px;
  }
  p {
    font-size: 14px;
  }
  c2-toast-region {
    width: 100%;
    --c2-toast-region__container--width: 100%;
  }
</style>
